
@model List<SwiftyS26.Models.Maintenance>
@{
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
    ViewBag.Title = "Maintenance History";
}

<div class="section-header">
    <div class="section-title">Maintenance History</div>
    <div class="section-sub">All maintenance you've performed — scheduled and ad-hoc</div>
</div>

<div class="dash-card">
    <div class="card-header">
        <div class="card-title"><i class="fas fa-clock-rotate-left"></i> Past Maintenance</div>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-clock-rotate-left"></i>
            <p>No maintenance history yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table" style="width:100%;border-collapse:collapse;font-size:13px;">
                <thead>
                    <tr>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Date</th>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Equipment</th>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Result</th>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Tasks Performed</th>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Cost</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        var outcomeColor = m.Result == "Completed" ? "var(--green)" : "var(--red)";
                        <tr>
                            <td style="padding:12px 16px;border-bottom:1px solid var(--border);color:var(--text-muted);font-size:12px;">@m.MaintenanceDate.ToString("dd MMM yyyy")</td>
                            <td style="padding:12px 16px;border-bottom:1px solid var(--border);">
                                <div class="member-name">@(m.Equipment?.Name)</div>
                                <div class="text-muted" style="font-size:12px;">@(m.Equipment?.EquipmentCode)</div>
                            </td>
                            <td style="padding:12px 16px;border-bottom:1px solid var(--border);">
                                <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;background:rgba(0,0,0,.04);color:@outcomeColor;">@(m.Result == "Completed" ? "Completed" : "Issue Found")</span>
                            </td>
                            <td class="notes-cell" style="padding:12px 16px;border-bottom:1px solid var(--border);">
                                @(string.IsNullOrEmpty(m.TasksPerformed) ? "—" : m.TasksPerformed)
                            </td>
                            <td style="padding:12px 16px;border-bottom:1px solid var(--border);color:var(--text-sub);font-size:12px;">
                                @(m.Cost.HasValue ? "R" + m.Cost.Value.ToString("F2") : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
