@model SwiftyS26.Models.ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_StoreStaffLayout.cshtml";
    ViewBag.Title = "Change Password";
}

<div style="max-width:420px;margin:0 auto;">
    <div style="margin-bottom:20px;">
        <h2 style="font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:1px;">CHANGE PASSWORD</h2>
    </div>

    <div style="background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:26px;">
        @using (Html.BeginForm("ChangePassword", "StoreStaff", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { style = "color:#DC2626;font-size:13px;margin-bottom:14px;display:block;" })

            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Current Password</label>
                @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", style = "width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;" })
            </div>
            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">New Password</label>
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", style = "width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;" })
            </div>
            <div style="margin-bottom:20px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Confirm New Password</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", style = "width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;" })
            </div>

            <button type="submit" style="width:100%;padding:12px;background:#2563EB;color:#fff;border:none;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;">
                Update Password
            </button>
        }
    </div>
</div>
