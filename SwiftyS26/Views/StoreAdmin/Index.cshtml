                <div class="pa-form-grid">
                    <div class="pa-field full">
                        <label for="edit_Name">
                            Product name <span class="pa-required">*</span>
                        </label>

                        <input id="edit_Name"
                               name="name"
                               class="pa-input"
                               type="text"
                               maxlength="150"
                               required />
                    </div>

                    <div class="pa-field full">
                        <label for="edit_Description">
                            Description
                        </label>

                        <textarea id="edit_Description"
                                  name="description"
                                  class="pa-input"
                                  maxlength="1000"></textarea>
                    </div>

                    <div class="pa-field full">
                        <label for="edit_Category">
                            Category <span class="pa-required">*</span>
                        </label>

                        <select id="edit_Category"
                                name="category"
                                class="pa-input"
                                required>
                            <option value="">Select a category</option>

                            @foreach (var category in categories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </div>

                    <div class="pa-field">
                        <label for="edit_NormalPrice">
                            Selling price (R)
                            <span class="pa-required">*</span>
                        </label>

                        <input id="edit_NormalPrice"
                               name="normalPrice"
                               class="pa-input"
                               type="number"
                               min="0.01"
                               step="0.01"
                               inputmode="decimal"
                               required />
                    </div>

                    <div class="pa-field">
                        <label for="edit_QuantityOnHand">
                            Quantity on hand
                            <span class="pa-required">*</span>
                        </label>

                        <input id="edit_QuantityOnHand"
                               name="quantityOnHand"
                               class="pa-input"
                               type="number"
                               min="0"
                               step="1"
                               required />
                    </div>

                    <div class="pa-field">
                        <label for="edit_ReorderLevel">
                            Reorder level
                        </label>

                        <input id="edit_ReorderLevel"
                               name="reorderLevel"
                               class="pa-input"
                               type="number"
                               min="0"
                               step="1" />
                    </div>

                    <div class="pa-field">
                        <label for="edit_ExpiryDate">
                            Expiry date
                        </label>

                        <input id="edit_ExpiryDate"
                               name="expiryDate"
                               class="pa-input"
                               type="date" />
                    </div>

                    <div class="pa-field full">
                        <label for="edit_Image">
                            Replace product image
                        </label>

                        <input id="edit_Image"
                               name="imageFile"
                               class="pa-input pa-file"
                               type="file"
                               accept="image/jpeg,image/png,image/webp" />

                        <span class="pa-field-help">
                            Leave empty to keep the existing image.
                        </span>
                    </div>

                    <div class="pa-field full">
                        <label class="pa-checkbox">
                            <input id="edit_IsActive"
                                   name="isActive"
                                   type="checkbox"
                                   value="true" />

                            <span>
                                <strong>Active and visible to members</strong>
                                <br />
                                Inactive products remain in business records
                                but cannot be purchased.
                            </span>
                        </label>
                    </div>
                </div>

                <div class="pa-modal-footer">
                    <button type="button"
                            class="pa-button light"
                            onclick="closeEditProductModal()">
                        Cancel
                    </button>

                    <button type="submit"
                            class="pa-button">
                        <i class="fas fa-floppy-disk"></i>
                        Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        "use strict";

        var addModal =
            document.getElementById("addProductModal");

        var editModal =
            document.getElementById("editProductModal");

        var searchInput =
            document.getElementById("productSearch");

        var categoryFilter =
            document.getElementById("categoryFilter");

        var statusFilter =
            document.getElementById("statusFilter");

        var resultCount =
            document.getElementById("productResultCount");

        var emptyState =
            document.getElementById("filteredEmptyState");

        function openModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.add("open");
            document.body.classList.add("pa-modal-open");
        }

        function closeModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.remove("open");

            if (!document.querySelector(".pa-modal.open")) {
                document.body.classList.remove("pa-modal-open");
            }
        }

        window.openAddProductModal = function () {
            openModal(addModal);

            window.setTimeout(function () {
                var nameInput =
                    document.getElementById("add_Name");

                if (nameInput) {
                    nameInput.focus();
                }
            }, 100);
        };

        window.closeAddProductModal = function () {
            closeModal(addModal);
        };

        window.openEditProductModal = function (
            id,
            name,
            description,
            category,
            price,
            quantity,
            reorderLevel,
            expiryDate,
            isActive) {

            document.getElementById("edit_ProductId").value =
                id;

            document.getElementById("edit_Name").value =
                name || "";

            document.getElementById("edit_Description").value =
                description || "";

            document.getElementById("edit_Category").value =
                category || "";

            document.getElementById("edit_NormalPrice").value =
                price || "0.00";

            document.getElementById("edit_QuantityOnHand").value =
                quantity;

            document.getElementById("edit_ReorderLevel").value =
                reorderLevel;

            document.getElementById("edit_ExpiryDate").value =
                expiryDate || "";

            document.getElementById("edit_IsActive").checked =
                isActive === true;

            openModal(editModal);

            window.setTimeout(function () {
                document.getElementById("edit_Name").focus();
            }, 100);
        };

        window.closeEditProductModal = function () {
            closeModal(editModal);
        };

        function applyFilters() {
            var rows =
                document.querySelectorAll(".pa-product-row");

            var search =
                searchInput
                    ? searchInput.value.trim().toLowerCase()
                    : "";

            var selectedCategory =
                categoryFilter
                    ? categoryFilter.value.toLowerCase()
                    : "";

            var selectedStatus =
                statusFilter
                    ? statusFilter.value
                    : "";

            var visibleCount = 0;

            rows.forEach(function (row) {
                var name =
                    row.getAttribute("data-name") || "";

                var description =
                    row.getAttribute("data-description") || "";

                var category =
                    (row.getAttribute("data-category") || "")
                        .toLowerCase();

                var stockStatus =
                    row.getAttribute("data-stock-status") || "";

                var activeStatus =
                    row.getAttribute("data-active") || "";

                var searchMatches =
                    !search ||
                    name.indexOf(search) >= 0 ||
                    description.indexOf(search) >= 0;

                var categoryMatches =
                    !selectedCategory ||
                    category === selectedCategory;

                var statusMatches =
                    !selectedStatus ||
                    stockStatus === selectedStatus ||
                    activeStatus === selectedStatus;

                var visible =
                    searchMatches &&
                    categoryMatches &&
                    statusMatches;

                row.style.display = visible ? "" : "none";

                if (visible) {
                    visibleCount++;
                }
            });

            if (resultCount) {
                resultCount.textContent =
                    visibleCount +
                    (visibleCount === 1
                        ? " product"
                        : " products");
            }

            if (emptyState) {
                emptyState.style.display =
                    visibleCount === 0
                        ? "block"
                        : "none";
            }
        }

        if (searchInput) {
            searchInput.addEventListener(
                "input",
                applyFilters);
        }

        if (categoryFilter) {
            categoryFilter.addEventListener(
                "change",
                applyFilters);
        }

        if (statusFilter) {
            statusFilter.addEventListener(
                "change",
                applyFilters);
        }

        document.querySelectorAll(".pa-modal")
            .forEach(function (modal) {
                modal.addEventListener(
                    "mousedown",
                    function (event) {
                        if (event.target === modal) {
                            closeModal(modal);
                        }
                    });
            });

        document.addEventListener(
            "keydown",
            function (event) {
                if (event.key === "Escape") {
                    closeModal(addModal);
                    closeModal(editModal);
                }
            });
    })();
</script>