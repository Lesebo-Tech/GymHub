@model SwiftyS26.ViewModels.ReviewUncollectedOrderViewModel
@using System
@using System.Linq
@using System.Globalization

@{
    Layout = Session["LoggedInAdmin"] != null
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_StoreStaffLayout.cshtml";

    ViewBag.Title = "Uncollected Order Review";
    ViewBag.PageTitle = "UNCOLLECTED ORDER REVIEW";

    var order = Model != null ? Model.Order : null;
    var isAdmin = Model != null &&
                  Model.IsAdmin &&
                  Session["LoggedInAdmin"] != null;

    var now = DateTime.Now;

    var isReadyForPickup =
        order != null &&
        order.Status == "ReadyForPickup";

    var isOverdue =
        isReadyForPickup &&
        order.PickupDeadline.HasValue &&
        order.PickupDeadline.Value <= now;

    var isWithinCollectionPeriod =
        isReadyForPickup &&
        order.PickupDeadline.HasValue &&
        order.PickupDeadline.Value > now;

    var canResolve =
        order != null &&
        isAdmin &&
        order.Status == "UncollectedPendingReview";

    var isResolved =
        order != null &&
        (order.Status == "UncollectedRefunded" ||
         order.Status == "UncollectedResolved");

    var isRefundPending =
        order != null &&
        order.Status == "UncollectedRefundPending";

    var memberName =
        order != null && order.Member != null
            ? order.Member.FullName
            : "Unknown member";

    var memberEmail =
        order != null && order.Member != null
            ? order.Member.Email
            : "Not available";

    var orderItems =
        order != null && order.Items != null
            ? order.Items.ToList()
            : new System.Collections.Generic.List<SwiftyS26.Models.StoreOrderItem>();

    var auditEvents =
        Model != null && Model.Events != null
            ? Model.Events.OrderByDescending(e => e.CreatedAt).ToList()
            : new System.Collections.Generic.List<SwiftyS26.Models.StoreOrderCollectionEvent>();

    var statusText = order != null ? order.Status : "Unknown";
    var statusClass = "default";

    if (order != null)
    {
        switch (order.Status)
        {
            case "ReadyForPickup":
                statusText = isOverdue ? "Deadline Expired" : "Ready for Pickup";
                statusClass = isOverdue ? "danger" : "info";
                break;

            case "UncollectedPendingReview":
                statusText = "Awaiting Admin Review";
                statusClass = "warning";
                break;

            case "UncollectedRefundPending":
                statusText = "Refund Pending";
                statusClass = "purple";
                break;

            case "UncollectedRefunded":
                statusText = "Refunded";
                statusClass = "success";
                break;

            case "UncollectedResolved":
                statusText = "Resolved";
                statusClass = "success";
                break;
        }
    }
}

<style>
    * {
        box-sizing: border-box;
    }

    .ur-page {
        width: 100%;
        padding-bottom: 36px;
        color: #0f172a;
    }

