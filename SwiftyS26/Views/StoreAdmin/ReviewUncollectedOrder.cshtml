    .ur-action-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 7px;
        font-size: 14px;
        font-weight: 850;
    }

        .ur-action-title i {
            color: #2563eb;
        }

    .ur-action-card.green .ur-action-title i {
