    }

    .ur-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        min-height: 42px;
        padding: 10px 15px;
        border: 0;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 850;
        cursor: pointer;
        text-decoration: none;
    }

        .ur-btn.full {
            width: 100%;
        }

        .ur-btn.blue {
            background: #2563eb;
            color: #fff;
        }

        .ur-btn.green {
            background: #16a34a;
            color: #fff;
        }

        .ur-btn.red {
            background: #dc2626;
