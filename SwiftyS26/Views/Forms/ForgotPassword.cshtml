@model SwiftyS26.Models.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GymHub – Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="~/Content/login.css" rel="stylesheet" />
</head>
<body>
    <nav>
        <div class="nav-logo">
            <div class="logo-icon">GH</div>
            <div class="logo-text">Gym<span>Hub</span></div>
        </div>
        <a href="/Forms/Login" class="nav-back">← Back to Sign In</a>
    </nav>

    <div class="login-wrap">
        <div class="login-card">

            <!-- Icon -->
            <div style="text-align:center;margin-bottom:20px;">
                <div style="width:64px;height:64px;background:rgba(59,130,246,0.15);
                            border:2px solid rgba(59,130,246,0.3);border-radius:50%;
                            display:flex;align-items:center;justify-content:center;
                            margin:0 auto;font-size:28px;"></div>
            </div>

            <div class="login-title">FORGOT PASSWORD</div>
            <p class="login-sub">
                Enter your registered email address and we will send
                you a 6-digit reset code.
            </p>

            @* Success message *@
            @if (TempData["ResetSuccess"] != null)
            {
                <div class="success-summary">
                    ✅ @TempData["ResetSuccess"]
                </div>
            }

            @* Error summary *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-summary">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            @using (Html.BeginForm("ForgotPassword", "Forms", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Email Address *</label>
                    @Html.TextBoxFor(m => m.Email, new
                    {
                        @type = "email",
                        placeholder = "you@example.com",
                        autocomplete = "email"
                    })
                    @Html.ValidationMessageFor(m => m.Email, "",
                        new { @class = "field-error", style = "display:block;" })
                </div>

                <button type="submit" class="btn-login" id="sendBtn">
                    Send Reset Code →
                </button>
            }

            <hr class="divider" />
            <div class="login-footer">
                Remembered it?
                <a href="/Forms/Login">Back to Sign In →</a>
            </div>
        </div>
    </div>
</body>
</html>