@model SwiftyS26.Models.Technician
@using SwiftyS26.Models
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Technician Management";
    ViewBag.PageTitle = "TECHNICIAN MANAGEMENT";
    ViewBag.ActiveNav = "technicians";
    var technicians = ViewBag.Technicians as List<Technician>;
}

@section Styles {
    <style>
        .badge-basic {
            background: var(--bg3);
            color: var(--muted);
        }

        .badge-fulltime {
            background: var(--green-light);
            color: var(--green);
        }

        .badge-parttime {
            background: var(--gold-light);
            color: var(--gold);
        }

        .badge-contract {
            background: var(--purple-light);
            color: var(--purple);
        }

        .badge-active {
            background: var(--green-light);
            color: var(--green);
        }

        .badge-inactive {
            background: var(--red-light);
            color: var(--red);
        }

        .trainer-code {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 14px;
            letter-spacing: 1px;
            color: var(--blue);
            background: var(--blue-light);
            padding: 4px 10px;
            border-radius: 6px;
            display: inline-block;
        }

        .action-bar {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .btn-edit {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--gold-light);
            color: var(--gold);
            border: 1px solid rgba(217,119,6,.2);
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all var(--transition);
            font-family: 'DM Sans', sans-serif;
        }

            .btn-edit:hover {
                background: var(--gold);
                color: #fff;
            }

        .btn-delete {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: var(--red-light);
            color: var(--red);
            border: 1px solid rgba(220,38,38,.2);
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all var(--transition);
            text-decoration: none;
            font-family: 'DM Sans', sans-serif;
        }

            .btn-delete:hover {
                background: var(--red);
                color: #fff;
            }

        .action-buttons {
            display: flex;
            gap: 8px;
        }

        .alert {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 600;
        }

        .alert-success {
            background: var(--green-light);
            color: var(--green);
            border: 1px solid rgba(22,163,74,.2);
        }

        .alert-danger {
            background: var(--red-light);
            color: var(--red);
            border: 1px solid rgba(220,38,38,.2);
        }

        .alert-warning {
            background: var(--gold-light);
            color: var(--gold);
            border: 1px solid rgba(217,119,6,.2);
        }

        .close-alert {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            margin-left: auto;
            color: inherit;
            opacity: 0.6;
        }

            .close-alert:hover {
                opacity: 1;
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-group {
            margin-bottom: 16px;
        }

            .form-group label {
                display: block;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.7px;
                color: var(--muted);
                margin-bottom: 6px;
            }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            background: var(--bg3);
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            color: var(--text);
            outline: none;
            transition: all var(--transition);
        }

            .form-control:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(37,99,235,.1);
                background: var(--white);
            }

        .modal-btn.save {
            background: var(--blue);
            color: #fff;
            box-shadow: 0 4px 12px rgba(37,99,235,.25);
        }

            .modal-btn.save:hover {
                background: var(--blue-dark);
            }
    </style>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="close-alert" onclick="this.parentElement.remove()">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="close-alert" onclick="this.parentElement.remove()">&times;</button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i> @TempData["Warning"]
        <button type="button" class="close-alert" onclick="this.parentElement.remove()">&times;</button>
    </div>
}

<!-- Stat Cards -->
<div class="admin-stats-grid">
    <div class="admin-stat-card blue">
        <div class="stat-icon"><i class="fas fa-tools"></i></div>
        <div class="stat-number">@(technicians?.Count ?? 0)</div>
        <div class="stat-label">Total Technicians</div>
    </div>
    <div class="admin-stat-card green">
        <div class="stat-icon"><i class="fas fa-user-check"></i></div>
        <div class="stat-number">@(technicians?.Count(t => t.IsActive) ?? 0)</div>
        <div class="stat-label">Active</div>
    </div>
    <div class="admin-stat-card gold">
        <div class="stat-icon"><i class="fas fa-clock"></i></div>
        <div class="stat-number">@(technicians?.Count(t => t.EmploymentType == "Part-time") ?? 0)</div>
        <div class="stat-label">Part-time</div>
    </div>
    <div class="admin-stat-card purple">
        <div class="stat-icon"><i class="fas fa-file-signature"></i></div>
        <div class="stat-number">@(technicians?.Count(t => t.EmploymentType == "Contract") ?? 0)</div>
        <div class="stat-label">Contract</div>
    </div>
</div>

<!-- Action Bar -->
<div class="action-bar">
    <button class="btn-primary" onclick="openAddModal()">
        <i class="fas fa-plus"></i> Add New Technician
    </button>
</div>

<!-- Technicians Table -->
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="fas fa-tools"></i> All Technicians</div>
        <div class="admin-card-count">@(technicians?.Count ?? 0) records</div>
    </div>
    <div class="search-bar">
        <input type="text" id="technicianSearch"
               placeholder="Search by name, code or specialization..."
               oninput="filterTable()" />
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table" id="techniciansTable">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Specialization</th>
                    <th>Certification</th>
                    <th>Employment</th>
                    <th>Status</th>
                    <th>Added</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (technicians == null || !technicians.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align:center;padding:48px;color:var(--muted);">
                            <i class="fas fa-tools" style="font-size:32px;opacity:.3;display:block;margin-bottom:12px;"></i>
                            No technicians found. Add one using the button above.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var t in technicians)
                    {
                        var empClass = t.EmploymentType == "Full-time" ? "badge-fulltime"
                                     : t.EmploymentType == "Part-time" ? "badge-parttime"
                                     : "badge-contract";
                        <tr>
                            <td><span class="trainer-code">@t.TechnicianCode</span></td>
                            <td class="member-name">@t.FullName</td>
                            <td class="member-phone">@t.PhoneNumber</td>
                            <td><span class="badge badge-basic">@t.Specialization</span></td>
                            <td class="member-date">@t.CertificationLevel</td>
                            <td><span class="badge @empClass">@t.EmploymentType</span></td>
                            <td><span class="badge @(t.IsActive ? "badge-active" : "badge-inactive")">@(t.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="member-date">@t.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-edit" onclick="openEdit(
                                        '@t.TechnicianId',
                                        '@t.FullName',
                                        '@t.Email',
                                        '@t.PhoneNumber',
                                        '@t.Gender',
                                        '@(t.DateOfBirth.HasValue ? t.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")',
                                        '@t.Specialization',
                                        '@t.CertificationLevel',
                                        '@t.EmploymentType')">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                    <a class="btn-delete"
                                       href="@Url.Action("DeleteTechnician", "Admin", new { id = t.TechnicianId })"
                                       onclick="return confirm('Delete @t.FullName? This cannot be undone.');">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Modals {
    <!-- ===== ADD MODAL ===== -->
    <div id="addModal" class="modal-overlay">
        <div class="modal-box">
            <div class="modal-title"><i class="fas fa-user-plus" style="color:var(--blue);font-size:20px;"></i> Add New Technician</div>
            @using (Html.BeginForm("CreateTechnician", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="form-group"><label>Full Name <span style="color:var(--red)">*</span></label><input name="FullName" class="form-control" placeholder="John Doe" required /></div>
                    <div class="form-group"><label>Email <span style="color:var(--red)">*</span></label><input name="Email" type="email" class="form-control" placeholder="john@email.com" required /></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Phone <span style="color:var(--red)">*</span></label><input name="PhoneNumber" class="form-control" placeholder="082 123 4567" required /></div>
                    <div class="form-group">
                        <label>Gender</label>
                        <select name="Gender" class="form-control">
                            <option value="">Select</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Date of Birth</label><input name="DateOfBirth" type="date" class="form-control" /></div>
                    <div class="form-group">
                        <label>Specialization</label>
                        <select name="Specialization" class="form-control">
                            <option value="">Select</option>
                            <option>Cardio Equipment</option>
                            <option>Strength Equipment</option>
                            <option>Electrical/Electronic Systems</option>
                            <option>General Mechanical</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Certification Level</label>
                        <select name="CertificationLevel" class="form-control">
                            <option value="">Select</option>
                            <option>Apprentice</option>
                            <option>Certified Technician</option>
                            <option>Senior Technician</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Employment Type</label>
                        <select name="EmploymentType" class="form-control">
                            <option value="">Select</option>
                            <option>Full-time</option>
                            <option>Part-time</option>
                            <option>Contract</option>
                        </select>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="submit" class="modal-btn save"><i class="fas fa-save"></i> Add Technician</button>
                    <button type="button" class="modal-btn cancel" onclick="closeAddModal()">Cancel</button>
                </div>
            }
        </div>
    </div>

    <!-- ===== EDIT MODAL ===== -->
    <div id="editModal" class="modal-overlay">
        <div class="modal-box">
            <div class="modal-title"><i class="fas fa-user-edit" style="color:var(--gold);font-size:20px;"></i> Edit Technician</div>
            @using (Html.BeginForm("EditTechnician", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="TechnicianId" id="editId" />
                <div class="form-row">
                    <div class="form-group"><label>Full Name</label><input class="form-control" name="FullName" id="editName" required /></div>
                    <div class="form-group"><label>Email</label><input class="form-control" type="email" name="Email" id="editEmail" required /></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Phone</label><input class="form-control" name="PhoneNumber" id="editPhone" required /></div>
                    <div class="form-group">
                        <label>Gender</label>
                        <select class="form-control" name="Gender" id="editGender">
                            <option value="">Select</option>
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Date of Birth</label><input class="form-control" type="date" name="DateOfBirth" id="editDob" /></div>
                    <div class="form-group">
                        <label>Specialization</label>
                        <select class="form-control" name="Specialization" id="editSpec">
                            <option value="">Select</option>
                            <option>Cardio Equipment</option>
                            <option>Strength Equipment</option>
                            <option>Electrical/Electronic Systems</option>
                            <option>General Mechanical</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Certification Level</label>
                        <select class="form-control" name="CertificationLevel" id="editCert">
                            <option value="">Select</option>
                            <option>Apprentice</option>
                            <option>Certified Technician</option>
                            <option>Senior Technician</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Employment Type</label>
                        <select class="form-control" name="EmploymentType" id="editEmp">
                            <option value="">Select</option>
                            <option>Full-time</option>
                            <option>Part-time</option>
                            <option>Contract</option>
                        </select>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="submit" class="modal-btn save"><i class="fas fa-save"></i> Update Technician</button>
                    <button type="button" class="modal-btn cancel" onclick="closeEdit()">Cancel</button>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function openAddModal() { document.getElementById('addModal').style.display = 'flex'; }
        function closeAddModal() { document.getElementById('addModal').style.display = 'none'; }
        function closeEdit() { document.getElementById('editModal').style.display = 'none'; }

        function openEdit(id, name, email, phone, gender, dob, spec, cert, emp) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editEmail').value = email;
            document.getElementById('editPhone').value = phone;
            document.getElementById('editDob').value = dob;
            setDropdown('editGender', gender);
            setDropdown('editSpec', spec);
            setDropdown('editCert', cert);
            setDropdown('editEmp', emp);
            document.getElementById('editModal').style.display = 'flex';
        }

        function setDropdown(id, value) {
            var select = document.getElementById(id);
            for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value === value || select.options[i].text === value) {
                    select.selectedIndex = i; break;
                }
            }
        }

        function filterTable() {
            var q = document.getElementById('technicianSearch').value.toLowerCase();
            document.querySelectorAll('#techniciansTable tbody tr').forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }

        document.querySelectorAll('.modal-overlay').forEach(function (overlay) {
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) {
                    overlay.style.display = 'none';
                }
            });
        });
    </script>
}