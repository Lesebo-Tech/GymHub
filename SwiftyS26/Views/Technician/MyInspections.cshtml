@model SwiftyS26.Models.MyInspectionsViewModel
@using System.Web
@{
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
    ViewBag.PageTitle = "My Inspections";
    var routine = Model?.RoutineAssigned ?? new List<SwiftyS26.Models.Equipment>();
    var verifications = Model?.VerificationAssigned ?? new List<SwiftyS26.Models.Repair>();
}

<div class="pg-header" style="margin-bottom:20px;">
    <h2 style="font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1.5px;">MY INSPECTIONS</h2>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#f0fdf4;color:#16a34a;border:1px solid rgba(22,163,74,.2);padding:12px 16px;border-radius:8px;margin-bottom:16px;font-weight:600;font-size:13px;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fef2f2;color:#dc2626;border:1px solid rgba(220,38,38,.2);padding:12px 16px;border-radius:8px;margin-bottom:16px;font-weight:600;font-size:13px;">
        @TempData["Error"]
    </div>
}

<!-- ===== ROUTINE INSPECTIONS ===== -->
<div style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#64748b;margin-bottom:10px;">
    <i class="fas fa-clipboard-check"></i> Routine Inspections Assigned To You
</div>

@if (!routine.Any())
{
    <div style="text-align:center;padding:36px;color:#64748b;background:#fff;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:28px;">
        <i class="fas fa-check-circle" style="font-size:28px;opacity:.3;display:block;margin-bottom:10px;"></i>
        No routine inspections assigned to you right now.
    </div>
}
else
{
    <div style="margin-bottom:28px;">
        @foreach (var e in routine)
        {
            <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px 20px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
                <div>
                    <div style="font-weight:700;font-size:15px;">@e.Name</div>
                    <div style="font-size:12px;color:#64748b;">@e.EquipmentCode — @e.GymArea</div>
                    <div style="font-size:12px;color:#64748b;margin-top:4px;">
                        <i class="fas fa-calendar"></i> Due: @(e.NextInspectionDueDate?.ToString("dd MMM yyyy") ?? "—")
                        @if (e.PendingInspectionAssignedDate.HasValue)
                        {
                            <span> · Assigned @e.PendingInspectionAssignedDate.Value.ToString("dd MMM yyyy")</span>
                        }
                    </div>
                </div>
                <button type="button" onclick="openPerformModal(@e.EquipmentId, '@Html.Raw(HttpUtility.JavaScriptStringEncode(e.Name))', '@e.EquipmentCode', null)"
                        style="padding:10px 20px;background:#2563eb;color:#fff;border:none;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;white-space:nowrap;">
                    <i class="fas fa-clipboard-check"></i> Perform Inspection
                </button>
            </div>
        }
    </div>
}

<!-- ===== VERIFICATIONS ===== -->
<div style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#64748b;margin-bottom:10px;">
    <i class="fas fa-user-check"></i> Repair Verifications Assigned To You
</div>

@if (!verifications.Any())
{
    <div style="text-align:center;padding:36px;color:#64748b;background:#fff;border:1px solid #e2e8f0;border-radius:12px;">
        <i class="fas fa-check-circle" style="font-size:28px;opacity:.3;display:block;margin-bottom:10px;"></i>
        No repair verifications assigned to you right now.
    </div>
}
else
{
    <div>
        @foreach (var r in verifications)
        {
            bool isVendorRepair = r.VendorId != null;
            <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px 20px;margin-bottom:12px;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
                    <div>
                        <div style="font-weight:700;font-size:15px;">@(r.Equipment?.Name)</div>
                        <div style="font-size:12px;color:#64748b;">@(r.Equipment?.EquipmentCode) — @(r.Equipment?.GymArea)</div>
                        <div style="font-size:12px;color:#334155;margin-top:6px;"><strong>Fault:</strong> @r.FaultDescription</div>
                        @if (!string.IsNullOrEmpty(r.DiagnosisNotes))
                        {
                            <div style="font-size:12px;color:#334155;margin-top:2px;"><strong>Repair notes:</strong> @r.DiagnosisNotes</div>
                        }
                        <div style="margin-top:8px;">
                            <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;background:@(isVendorRepair ? "#fff7ed" : "#f5f3ff");color:@(isVendorRepair ? "#ea580c" : "#7c3aed");">
                                <i class="fas @(isVendorRepair ? "fa-truck" : "fa-tools")"></i> @(isVendorRepair ? "Vendor Repair" : "Technician Repair")
                            </span>
                        </div>
                    </div>
                    <button type="button" onclick="openPerformModal(@r.EquipmentId, '@Html.Raw(HttpUtility.JavaScriptStringEncode(r.Equipment?.Name))', '@r.Equipment?.EquipmentCode', @r.RepairId)"
                            style="padding:10px 20px;background:@(isVendorRepair ? "#ea580c" : "#7c3aed");color:#fff;border:none;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;white-space:nowrap;">
                        <i class="fas fa-clipboard-check"></i> @(isVendorRepair ? "Verify Vendor Repair" : "Verify Repair")
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- ===== PERFORM INSPECTION MODAL ===== -->
<div id="performModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:14px;padding:26px;max-width:460px;width:90%;">
        <div style="font-weight:700;font-size:16px;margin-bottom:4px;">Perform Inspection</div>
        <p style="font-size:13px;color:#64748b;margin-bottom:16px;">
            <span id="performEquipName"></span> (<span id="performEquipCode"></span>)
        </p>
        @using (Html.BeginForm("PerformInspection", "Inspection", FormMethod.Post, new { id = "performForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="equipmentId" id="perform_EquipmentId" />
            <input type="hidden" name="repairId" id="perform_RepairId" />
            <input type="hidden" name="technicianId" value="@ViewBag.TechnicianId" />

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Result <span style="color:#dc2626;">*</span></label>
                <select name="result" required style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;">
                    <option value="">Select</option>
                    <option value="Pass">Pass</option>
                    <option value="Fail">Fail</option>
                </select>
            </div>

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Findings</label>
                <textarea name="findings" style="width:100%;min-height:80px;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;" placeholder="What was observed"></textarea>
            </div>

            <div style="margin-bottom:16px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Action Taken (if Fail)</label>
                <input name="actionTaken" style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;" placeholder="Optional" />
            </div>

            <div style="display:flex;gap:10px;">
                <button type="submit" style="flex:1;padding:11px;background:#2563eb;color:#fff;border:none;border-radius:8px;font-weight:700;cursor:pointer;">Submit</button>
                <button type="button" onclick="closePerformModal()" style="flex:1;padding:11px;background:transparent;border:1px solid #e2e8f0;border-radius:8px;font-weight:700;cursor:pointer;">Cancel</button>
            </div>
        }
    </div>
</div>

<script>
    function openPerformModal(equipmentId, equipName, equipCode, repairId) {
        document.getElementById('perform_EquipmentId').value = equipmentId;
        document.getElementById('perform_RepairId').value = repairId || '';
        document.getElementById('performEquipName').textContent = equipName;
        document.getElementById('performEquipCode').textContent = equipCode;
        document.getElementById('performModal').style.display = 'flex';
    }
    function closePerformModal() { document.getElementById('performModal').style.display = 'none'; }
</script>
