@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GymHub – Staff Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/Content/login.css" rel="stylesheet" />
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav>
        <div class="nav-logo">
            <div class="logo-icon">GH</div>
            <div class="logo-text">Gym<span>Hub</span></div>
        </div>
        <a href="/Home/About" class="nav-back">← Back Home</a>
    </nav>

    <!-- ===== MAIN ===== -->
    <div class="login-wrap">
        <div class="login-card">

            <!-- Admin badge -->

            <div class="login-title">STAFF LOGIN</div>


            <!-- Error message from controller -->
            @if (ViewBag.Error != null)
            {
                <div class="error-summary">@ViewBag.Error</div>
            }

            @using (Html.BeginForm("Login", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Staff Email *</label>
                    <input type="email" name="Email"
                           placeholder="admin@gymhub.co.za"
                           value="@ViewBag.Email"
                           autocomplete="email" required />
                    <div class="field-error" id="err-email">Please enter your email address.</div>
                </div>

                <div class="form-group">
                    <label>Password *</label>
                    <div class="input-wrap">
                        <input type="password" id="Password" name="Password"
                               placeholder="Enter password"
                               autocomplete="current-password" required />
                        <span class="input-badge" onclick="toggleAdminPassword()" title="Show/hide password">👁</span>
                    </div>
                    <div class="field-error" id="err-password">Please enter your password.</div>
                </div>

                <div class="remember-row">
                    <label>
                        <input type="checkbox" name="RememberMe" />
                        Remember me
                    </label>
                </div>

                <button type="submit" class="btn-login">
                    Sign In →
                </button>
            }

            <hr class="divider" />

            <div class="login-footer">
                Not an admin?
                <a href="/Forms/Login">Member Login</a>
            </div>

        </div>
    </div>

    <script>
        function toggleAdminPassword() {
            var input = document.getElementById('adminPassword');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>

</body>
</html>