<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - GymHub Trainer Portal</title>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        /* ============================================================
           CSS VARIABLES
        ============================================================ */
        :root {
            /* ── Brand blues ── */
            --blue: #2563eb;
            --blue-dark: #1d4ed8;
            --blue-bright: #3b82f6;
            --blue-light: #eff6ff;
            --blue-mid: #dbeafe;
            /* ── Semantic colours ── */
            --green: #16a34a;
            --green-light: #f0fdf4;
            --red: #dc2626;
            --red-light: #fef2f2;
            --gold: #d97706;
            --gold-light: #fffbeb;
            --orange: #ea580c;
            --orange-light: #fff7ed;
            --purple: #7c3aed;
            --purple-light: #f5f3ff;
            /* ── Text ── */
            --text-primary: #111111;
            --text-sub: #334155;
            --text-secondary: #555555;
            --text-muted: #aaaaaa;
            /* ── Surfaces ── */
            --bg: #f0f2f5;
            --bg2: #ffffff;
            --bg3: #f1f5f9;
            --sidebar-bg: #ffffff;
            --border: #e2e8f0;
            /* ── Misc ── */
            --avatar-bg: linear-gradient(135deg, #f5a623, #e67e00);
            --shadow: 0 8px 40px rgba(0,0,0,.10);
            --shadow-sm: 0 1px 3px rgba(0,0,0,.06);
            --shadow-md: 0 4px 16px rgba(0,0,0,.08);
            --shadow-lg: 0 10px 40px rgba(0,0,0,.10);
            /* ── Radius ── */
            --radius: 10px;
            --radius-sm: 10px;
            --radius-md: 12px;
            --radius-lg: 14px;
            /* ── Layout ── */
            --sidebar-w: 268px;
            --font: 'DM Sans', sans-serif;
            /* ── Legacy aliases (keep accent for backward compat) ── */
            --accent: #2563eb;
            --accent-light: #eff6ff;
            --accent-hover: #1d4ed8;
        }

        /* ============================================================
           RESET
        ============================================================ */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: var(--font);
            cursor: pointer;
            border: none;
            background: none;
        }

        /* ============================================================
           LAYOUT SHELL
        ============================================================ */
        .layout {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* ============================================================
           SIDEBAR
        ============================================================ */
        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            background: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            height: 100vh;
            position: sticky;
            top: 0;
            overflow-y: auto;
            box-shadow: var(--shadow);
            z-index: 100;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 16px 16px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .logo-box {
            width: 40px;
            height: 40px;
            background: var(--blue);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
            color: #fff;
            letter-spacing: .5px;
            flex-shrink: 0;
        }

        .logo-text {
            font-weight: 800;
            font-size: 17px;
            letter-spacing: 1.5px;
            color: var(--text-primary);
        }

        .nav-section {
            padding: 14px 10px 6px;
        }

        .section-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: 0 8px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 13.5px;
            font-weight: 500;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }

            .nav-item:hover {
                background: var(--blue-light);
                color: var(--blue);
            }

            .nav-item.active {
                background: var(--blue-light);
                color: var(--blue);
                font-weight: 600;
            }

            .nav-item svg {
                width: 17px;
                height: 17px;
                flex-shrink: 0;
                opacity: .65;
                transition: opacity .15s;
            }

            .nav-item:hover svg,
            .nav-item.active svg {
                opacity: 1;
            }

        .nav-divider {
            height: 1px;
            background: var(--border);
            margin: 4px 10px;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 10px;
            border-top: 1px solid var(--border);
            flex-shrink: 0;
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: background .15s;
        }

            .profile-card:hover {
                background: #f5f5f5;
            }

        .avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--avatar-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
            color: #fff;
            flex-shrink: 0;
        }

        .profile-info {
            flex: 1;
            min-width: 0;
        }

        .profile-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profile-role {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 1px;
        }

        .profile-menu-btn {
            color: var(--text-muted);
            font-size: 18px;
            font-weight: 700;
            padding: 2px 4px;
            border-radius: 6px;
            transition: background .15s;
        }

            .profile-menu-btn:hover {
                background: #eee;
            }

        .signout-form {
            display: inline;
        }

        /* ============================================================
           MAIN CONTENT
        ============================================================ */
        .main-content {
            flex: 1;
            padding: 32px 36px;
            min-width: 0;
            overflow-y: auto;
        }

        /* ============================================================
           ALERT BANNERS
        ============================================================ */
        .alert {
            padding: 12px 18px;
            border-radius: var(--radius-sm);
            font-size: 13.5px;
            font-weight: 500;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-success {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .alert-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        /* ============================================================
           SECTION HEADER  (used by every view)
        ============================================================ */
        .section-header {
            margin-bottom: 28px;
        }

        .section-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-primary);
        }

        .section-sub {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* ============================================================
           DASH CARD  (used by Dashboard, MyMembers, etc.)
        ============================================================ */
        .dash-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            margin-bottom: 24px;
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            background: var(--bg3);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .card-title {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-primary);
        }

        .card-action-btn {
            font-size: 13px;
            font-weight: 600;
            color: var(--blue);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: opacity .15s;
        }

            .card-action-btn:hover {
                opacity: .75;
            }

        /* ============================================================
           BUTTONS
        ============================================================ */
        .btn-primary-sm {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            background: var(--blue);
            color: #fff;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-primary-sm:hover {
                background: var(--blue-dark);
            }

        .btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
            background: #fff;
            border: 1px solid var(--border);
            transition: all .2s;
        }

            .btn-ghost:hover {
                background: var(--blue-light);
                color: var(--blue);
                border-color: rgba(37,99,235,.2);
            }

        /* ============================================================
           TABLE UTILITIES
        ============================================================ */
        .table-responsive {
            overflow-x: auto;
        }

        .action-links {
            display: flex;
            gap: 12px;
        }

        .link-success {
            color: var(--green);
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .link-info {
            color: var(--blue);
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .link-success:hover {
            text-decoration: underline;
        }

        .link-info:hover {
            text-decoration: underline;
        }

        .action-buttons {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .inline-form {
            display: inline;
        }

        .action-btn {
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-family: var(--font);
            transition: all .15s;
        }

            .action-btn.success {
                background: var(--green-light);
                color: var(--green);
            }

                .action-btn.success:hover {
                    background: var(--green);
                    color: #fff;
                }

            .action-btn.danger {
                background: var(--red-light);
                color: var(--red);
            }

                .action-btn.danger:hover {
                    background: var(--red);
                    color: #fff;
                }

        /* ============================================================
           TYPOGRAPHY UTILITIES
        ============================================================ */
        .member-name {
            font-weight: 600;
            color: var(--text-primary);
        }

        .text-muted {
            color: var(--text-muted);
        }

        .text-sub {
            color: var(--text-sub);
        }

        .notes-cell {
            max-width: 200px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ============================================================
           EMPTY STATE
        ============================================================ */
        .empty-state {
            text-align: center;
            padding: 48px 20px;
            color: var(--text-muted);
        }

            .empty-state i {
                font-size: 40px;
                margin-bottom: 12px;
                opacity: .4;
                display: block;
            }

            .empty-state p {
                font-size: 14px;
                margin-bottom: 12px;
            }

        .empty-state-btn {
            display: inline-block;
            padding: 9px 20px;
            background: var(--blue);
            color: #fff;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: background .15s;
        }

            .empty-state-btn:hover {
                background: var(--blue-dark);
            }

        /* ============================================================
           CARD UTILITY
        ============================================================ */
        .card {
            background: #fff;
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: 0 2px 16px rgba(0,0,0,.06);
        }

        /* ============================================================
           RESPONSIVE — MOBILE OVERLAY SIDEBAR
        ============================================================ */
        .sidebar-toggle {
            display: none;
            position: fixed;
            top: 14px;
            left: 14px;
            z-index: 200;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--blue);
            color: #fff;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(37,99,235,.35);
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: fixed;
                transform: translateX(calc(-1 * var(--sidebar-w)));
                transition: transform .28s cubic-bezier(.4,0,.2,1);
                height: 100%;
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .sidebar-toggle {
                display: flex;
            }

            .main-content {
                padding: 20px 16px;
                padding-top: 64px;
            }

            .overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.3);
                z-index: 99;
            }

                .overlay.show {
                    display: block;
                }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="layout">

        <!-- ── MOBILE TOGGLE ── -->
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Open menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>
        <div class="overlay" id="overlay"></div>

        <!-- ── SIDEBAR ── -->
        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <div class="logo-box">GH</div>
                <span class="logo-text">GYMHUB</span>
            </div>

            <nav class="nav-section">
                <div class="section-label">Trainer</div>

                <a href="@Url.Action("Dashboard", "Trainer")"
                   class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a href="@Url.Action("MyMembers", "Trainer")"
                   class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "MyMembers" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    My Members
                </a>

                <a href="@Url.Action("Schedule", "Trainer")"
                   class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Schedule" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                    Schedule
                </a>

                @{
                    var action = ViewContext.RouteData.Values["action"].ToString();
                    bool workoutActive = action == "WorkoutPrograms" || action == "CreateWorkoutProgram" || action == "AddExercises";
                    bool progressActive = action == "MemberProgress" || action == "LogProgress" || action == "MemberWeeklyProgress";
                }

                <a href="@Url.Action("WorkoutPrograms", "Trainer")"
                   class="nav-item @(workoutActive ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6.5 6.5h11M6.5 12h11M6.5 17.5h11" />
                        <path d="M3 6.5h.01M3 12h.01M3 17.5h.01" />
                    </svg>
                    Workout Programs
                </a>

                <a href="@Url.Action("MemberProgress", "Trainer")"
                   class="nav-item @(progressActive ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                    </svg>
                    Progress Tracking
                </a>

                <a href="@Url.Action("Availability", "Trainer")"
                   class="nav-item @(action == "Availability" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    Availability
                </a>
            </nav>

            <div class="nav-divider"></div>

            <nav class="nav-section">
                <div class="section-label">Account</div>

                <a href="@Url.Action("ChangePassword", "Trainer")"
                   class="nav-item @(action == "ChangePassword" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    Change Password
                </a>
            </nav>

            <!-- Profile Footer -->
            <div class="sidebar-footer">
                @{
                    string trainerName = ViewBag.TrainerName as string ?? "Trainer";
                    string trainerRole = ViewBag.TrainerRole as string ?? "Trainer";
                    string initials = string.Concat(
                        trainerName.Split(' ')
                                   .Where(w => w.Length > 0)
                                   .Take(2)
                                   .Select(w => w[0].ToString().ToUpper()));
                }

                <div class="profile-card">
                    <div class="avatar">@initials</div>
                    <div class="profile-info">
                        <div class="profile-name">@trainerName</div>
                        <div class="profile-role">@trainerRole</div>
                    </div>
                    @using (Html.BeginForm("Logout", "Trainer", FormMethod.Post, new { @class = "signout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="profile-menu-btn" title="Sign Out">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                        </button>
                    }
                </div>
            </div>

        </aside>

        <!-- ── MAIN CONTENT ── -->
        <main class="main-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    @TempData["Error"]
                </div>
            }

            @RenderBody()

        </main>

    </div>

    <script>
        (function () {
            var sidebar = document.getElementById('sidebar');
            var toggle = document.getElementById('sidebarToggle');
            var overlay = document.getElementById('overlay');

            function openSidebar() { sidebar.classList.add('open'); overlay.classList.add('show'); }
            function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('show'); }

            if (toggle) toggle.addEventListener('click', openSidebar);
            if (overlay) overlay.addEventListener('click', closeSidebar);
        })();
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
