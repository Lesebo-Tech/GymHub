    }
</style>

<div class="ur-page">

    @if (order == null)
    {
        <div class="ur-alert error">
            <i class="fas fa-circle-exclamation"></i>
            <div>The requested uncollected order could not be found.</div>
        </div>

        <a class="ur-btn light"
           href="@Url.Action("UncollectedOrders", "StoreAdmin")">
            <i class="fas fa-arrow-left"></i>
            Back to Uncollected Orders
        </a>
    }
    else
    {
        <div class="ur-header">
            <div class="ur-title">
                <div class="ur-title-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>

                <div>
                    <h2>Uncollected Order Review</h2>
                    <p>
                        @order.ReferenceNumber
                        · Created @order.CreatedAt.ToString("dd MMM yyyy HH:mm")
                    </p>
                </div>
            </div>

            <span class="ur-status @statusClass">
                <i class="fas fa-circle" style="font-size:6px"></i>
                @statusText
            </span>
        </div>

        if (TempData["Success"] != null)
        {
            <div class="ur-alert success">
                <i class="fas fa-circle-check"></i>
                <div>@TempData["Success"]</div>
            </div>
        }

        if (TempData["Error"] != null)
        {
            <div class="ur-alert error">
                <i class="fas fa-circle-exclamation"></i>
                <div>@TempData["Error"]</div>
            </div>
        }

        if (isWithinCollectionPeriod)
        {
            <div class="ur-alert info">
                <i class="fas fa-clock"></i>
                <div>
                    This order is still within its collection period.
                    The deadline is
                    <strong>@order.PickupDeadline.Value.ToString("dd MMM yyyy HH:mm")</strong>.
                </div>
            </div>
        }

        if (isOverdue)
        {
            <div class="ur-alert warning">
                <i class="fas fa-triangle-exclamation"></i>
                <div>
                    This order has passed its collection deadline. Run
                    <strong>Process Due Orders</strong> from the Uncollected Orders page
                    before making a final decision.
                </div>
            </div>
        }

        if (!isAdmin && order.Status == "UncollectedPendingReview")
        {
            <div class="ur-alert warning">
                <i class="fas fa-user-shield"></i>
                <div>
                    Store Staff may review the case and contact the member, but only an
                    Administrator can make the final refund or closure decision.
                </div>
            </div>
        }

        <div class="ur-summary-grid">
            <section class="ur-card">
                <div class="ur-card-head">
                    <i class="fas fa-user"></i>
                    <h3>Member and Order Information</h3>
                </div>

                <div class="ur-card-body">
                    <div class="ur-details">
                        <div>
                            <span class="ur-detail-label">Member</span>
                            <div class="ur-detail-value">@memberName</div>
                        </div>

                        <div>
                            <span class="ur-detail-label">Email</span>
                            <div class="ur-detail-value">@memberEmail</div>
                        </div>

                        <div>
                            <span class="ur-detail-label">Order Reference</span>
                            <div class="ur-detail-value">@order.ReferenceNumber</div>
                        </div>

                        <div>
                            <span class="ur-detail-label">Paystack Reference</span>
                            <div class="ur-detail-value">
                                @(string.IsNullOrWhiteSpace(order.PaystackReference)
                                    ? "—"
                                    : order.PaystackReference)
                            </div>
                        </div>

                        <div>
                            <span class="ur-detail-label">Ready Date</span>
                            <div class="ur-detail-value">
                                @(order.ReadyAt.HasValue
                                    ? order.ReadyAt.Value.ToString("dd MMM yyyy HH:mm")
                                    : "—")
                            </div>
                        </div>

                        <div>
                            <span class="ur-detail-label">Collection Deadline</span>
                            <div class="ur-detail-value">
                                @(order.PickupDeadline.HasValue
                                    ? order.PickupDeadline.Value.ToString("dd MMM yyyy HH:mm")
                                    : "—")
                            </div>
                        </div>

                        <div>
                            <span class="ur-detail-label">Uncollected Date</span>
                            <div class="ur-detail-value">
                                @(order.UncollectedAt.HasValue
                                    ? order.UncollectedAt.Value.ToString("dd MMM yyyy HH:mm")
                                    : "—")
                            </div>
                        </div>

                        <div>
                            <span class="ur-detail-label">Stock Position</span>
                            <div class="ur-detail-value">
                                @if (order.IsPickupStockReserved)
                                {
                                    <span style="color:#2563eb">
                                        <i class="fas fa-lock"></i> Reserved
                                    </span>
                                }
                                else
                                {
                                    <span style="color:#16a34a">
                                        <i class="fas fa-lock-open"></i> Released
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <aside class="ur-card">
                <div class="ur-card-head">
                    <i class="fas fa-coins"></i>
                    <h3>Financial Summary</h3>
                </div>

                <div class="ur-card-body">
                    <div class="ur-money-row">
                        <span>Subtotal</span>
                        <strong>@("R" + order.Subtotal.ToString("F2"))</strong>
                    </div>

                    <div class="ur-money-row discount">
                        <span>Discount paid</span>
                        <strong>
                            @("-R" + order.DiscountAmount.ToString("F2"))
                        </strong>
                    </div>

                    <div class="ur-money-row total">
                        <span>Maximum refund</span>
                        <strong>@("R" + order.FinalTotal.ToString("F2"))</strong>
                    </div>

                    <p class="ur-financial-note">
                        Refunds must use the actual amount paid after any membership
                        discount. The maximum refundable amount cannot exceed the final
                        order total.
                    </p>
                </div>
            </aside>
        </div>

        <section class="ur-card ur-section">
            <div class="ur-card-head">
                <i class="fas fa-boxes-stacked"></i>
                <h3>Ordered Items and Stock Position</h3>
            </div>

            @if (!orderItems.Any())
            {
                <div class="ur-empty">
                    No order items were found for this order.
                </div>
            }
            else
            {
                <div class="ur-table-wrap">
                    <table class="ur-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Ordered Quantity</th>
                                <th>Available Now</th>
                                <th>Extension Check</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in orderItems)
                            {
                                var productExists = item.Product != null;
                                var productName = productExists
                                    ? item.Product.Name
                                    : "Product unavailable";

                                var availableQuantity = productExists
                                    ? item.Product.QuantityOnHand
                                    : 0;

                                var canSupply =
                                    productExists &&
                                    item.Product.IsActive &&
                                    availableQuantity >= item.Quantity;

                                <tr>
                                    <td>
                                        <span class="ur-product">@productName</span>
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>@availableQuantity</td>
                                    <td>
                                        @if (canSupply)
                                        {
                                            <span class="ur-check ok">
                                                <i class="fas fa-circle-check"></i>
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="ur-check bad">
                                                <i class="fas fa-circle-xmark"></i>
                                                Insufficient stock
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="ur-card ur-section">
            <div class="ur-card-head">
                <i class="fas fa-clock-rotate-left"></i>
                <h3>Collection Audit Timeline</h3>
            </div>

            <div class="ur-card-body">
                @if (!auditEvents.Any())
                {
                    <div class="ur-empty">
                        No collection events have been recorded yet.
                    </div>
                }
                else
                {
                    <div class="ur-timeline">
                        @foreach (var auditEvent in auditEvents)
                        {
                            <div class="ur-event">
                                <div class="ur-event-icon">
                                    <i class="fas fa-check"></i>
                                </div>

                                <div>
                                    <div class="ur-event-title">
                                        @auditEvent.EventType
                                    </div>

                                    <div class="ur-event-description">
                                        @auditEvent.Description
                                    </div>

                                    <div class="ur-event-by">
                                        Recorded by
                                        @(string.IsNullOrWhiteSpace(auditEvent.PerformedBy)
                                            ? "GymHub System"
                                            : auditEvent.PerformedBy)
                                    </div>
                                </div>

                                <div class="ur-event-date">
                                    @auditEvent.CreatedAt.ToString("dd MMM yyyy")
                                    <br />
                                    @auditEvent.CreatedAt.ToString("HH:mm")
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        if (canResolve)
        {
            <section class="ur-resolution">
                <div class="ur-resolution-head">
                    <div>
                        <h3>
                            <i class="fas fa-user-shield"></i>
                            Administrator Resolution
                        </h3>
                        <p>
                            Choose one outcome. Every decision is recorded in the
                            permanent collection audit history.
                        </p>
                    </div>

                    <span class="ur-admin-badge">Admin only</span>
                </div>

                <div class="ur-action-grid">

                    <!-- EXTEND DEADLINE -->
                    <div class="ur-action-card blue">
                        @using (Html.BeginForm(
                            "ExtendUncollectedDeadline",
                            "StoreAdmin",
                            FormMethod.Post,
                            new { @class = "ur-action-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="orderId"
                                   value="@order.StoreOrderId" />

                            <div class="ur-action-content">
                                <div class="ur-action-title">
                                    <i class="fas fa-calendar-plus"></i>
                                    Extend Pickup Deadline
                                </div>

                                <p class="ur-action-description">
                                    Give the member additional time and reserve the
                                    required stock again.
                                </p>

                                @if (Model.CanReReserveStock)
                                {
                                    <div class="ur-stock-box ok">
                                        <i class="fas fa-circle-check"></i>
                                        Sufficient stock is available to extend this order.
                                    </div>
                                }
                                else
                                {
                                    <div class="ur-stock-box bad">
                                        <strong>
                                            <i class="fas fa-circle-xmark"></i>
                                            The deadline cannot be extended.
                                        </strong>

                                        @if (Model.StockProblems != null &&
                                             Model.StockProblems.Any())
                                        {
                                            <ul>
                                                @foreach (var problem in Model.StockProblems)
                                                {
                                                    <li>@problem</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }

                                <div class="ur-field">
                                    <label for="newDeadline">
                                        New collection deadline *
                                    </label>
                                    <input id="newDeadline"
                                           name="newDeadline"
                                           type="datetime-local"
                                           min="@now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm")"
                                           required />
                                </div>

                                <div class="ur-field">
                                    <label for="extensionReason">
                                        Extension reason *
                                    </label>
                                    <textarea id="extensionReason"
                                              name="reason"
                                              minlength="10"
                                              maxlength="500"
                                              required
                                              placeholder="Explain why additional collection time is being granted."></textarea>
                                    <span class="ur-help">
                                        Minimum 10 characters.
                                    </span>
                                </div>
                            </div>

                            if (Model.CanReReserveStock)
                            {
                                <button type="submit"
                                        class="ur-btn blue full">
                                    <i class="fas fa-calendar-check"></i>
                                    Extend Deadline
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="ur-btn full"
                                        disabled>
                                    <i class="fas fa-ban"></i>
                                    Stock Unavailable
                                </button>
                            }
                        }
                    </div>

                    <!-- REFUND -->
                    <div class="ur-action-card green">
                        @using (Html.BeginForm(
                            "RefundUncollectedOrder",
                            "StoreAdmin",
                            FormMethod.Post,
                            new { @class = "ur-action-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="orderId"
                                   value="@order.StoreOrderId" />

                            <div class="ur-action-content">
                                <div class="ur-action-title">
                                    <i class="fas fa-money-bill-transfer"></i>
                                    Issue Refund
                                </div>

                                <p class="ur-action-description">
                                    Refund all or part of the amount paid through the
                                    original Paystack transaction.
                                </p>

                                <div class="ur-warning-box">
                                    <i class="fas fa-shield-halved"></i>
                                    <span>
                                        The refund may not exceed
                                        <strong>@("R" + order.FinalTotal.ToString("F2"))</strong>.
                                    </span>
                                </div>

                                <div class="ur-field">
                                    <label for="refundAmount">
                                        Refund amount *
                                    </label>
                                    <input id="refundAmount"
                                           name="refundAmount"
                                           type="number"
                                           min="0.01"
                                           max="@order.FinalTotal.ToString("0.00", CultureInfo.InvariantCulture)"
                                           step="0.01"
                                           value="@order.FinalTotal.ToString("0.00", CultureInfo.InvariantCulture)"
                                           required />
                                    <span class="ur-help">
                                        Maximum:
                                        @("R" + order.FinalTotal.ToString("F2"))
                                    </span>
                                </div>

                                <div class="ur-field">
                                    <label for="refundReason">
                                        Refund reason *
                                    </label>
                                    <textarea id="refundReason"
                                              name="reason"
                                              minlength="10"
                                              maxlength="500"
                                              required
                                              placeholder="Record the reason for approving this refund."></textarea>
                                    <span class="ur-help">
                                        Minimum 10 characters.
                                    </span>
                                </div>
                            </div>

                            <button type="submit"
                                    class="ur-btn green full"
                                    onclick="return confirm('Process this refund? This action may initiate a financial transaction.');">
                                <i class="fas fa-money-bill-wave"></i>
                                Process Refund
                            </button>
                        }
                    </div>

                    <!-- RESOLVE WITHOUT REFUND -->
                    <div class="ur-action-card red">
                        @using (Html.BeginForm(
                            "ResolveUncollectedWithoutRefund",
                            "StoreAdmin",
                            FormMethod.Post,
                            new { @class = "ur-action-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="orderId"
                                   value="@order.StoreOrderId" />

                            <div class="ur-action-content">
                                <div class="ur-action-title">
                                    <i class="fas fa-lock"></i>
                                    Resolve Without Refund
                                </div>

                                <p class="ur-action-description">
                                    Close the case without issuing money to the member.
                                    A clear business reason is required.
                                </p>

                                <div class="ur-warning-box">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    <span>
                                        Use this option only when a refund is not applicable.
                                        The reason becomes part of the permanent audit record.
                                    </span>
                                </div>

                                <div class="ur-field">
                                    <label for="resolutionReason">
                                        Decision reason *
                                    </label>
                                    <textarea id="resolutionReason"
                                              name="reason"
                                              minlength="10"
                                              maxlength="500"
                                              required
                                              placeholder="Explain why this case is being closed without a refund."></textarea>
                                    <span class="ur-help">
                                        Minimum 10 characters.
                                    </span>
                                </div>
                            </div>

                            <button type="submit"
                                    class="ur-btn red full"
                                    onclick="return confirm('Resolve this order without issuing a refund?');">
                                <i class="fas fa-lock"></i>
                                Resolve Without Refund
                            </button>
                        }
                    </div>
                </div>
            </section>
        }
        else if (isRefundPending)
        {
            <div class="ur-alert info">
                <i class="fas fa-spinner"></i>
                <div>
                    The refund has been initiated and is awaiting confirmation.
                    No further decision can be made while the refund is pending.
                </div>
            </div>
        }
        else if (isResolved)
        {
            <div class="ur-alert success">
                <i class="fas fa-circle-check"></i>
                <div>
                    This uncollected order case has already been resolved. Its
                    information remains available as a read-only audit record.
                </div>
            </div>
        }
        else if (isOverdue)
        {
            <div class="ur-alert warning">
                <i class="fas fa-rotate"></i>
                <div>
                    Process this overdue order from the Manage Uncollected Orders
                    page before attempting a final resolution.
                </div>
            </div>
        }

        <div class="ur-footer-actions">
            <a class="ur-btn light"
               href="@Url.Action("UncollectedOrders", "StoreAdmin")">
                <i class="fas fa-arrow-left"></i>
                Back to Uncollected Orders
            </a>
        </div>
    }
</div>