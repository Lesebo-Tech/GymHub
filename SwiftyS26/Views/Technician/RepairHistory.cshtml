@model List<SwiftyS26.Models.RepairAssignment>
@{
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
    ViewBag.Title = "Repair History";
}

<div class="section-header">
    <div class="section-title">Repair History</div>
    <div class="section-sub">Repairs you've completed, declined, or escalated</div>
</div>

<div class="dash-card">
    <div class="card-header">
        <div class="card-title"><i class="fas fa-history"></i> Past Assignments</div>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-clock-rotate-left"></i>
            <p>No repair history yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table" style="width:100%;border-collapse:collapse;font-size:13px;">
                <thead>
                    <tr>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Equipment</th>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Assigned</th>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Outcome</th>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Repair Status</th>
                        <th style="padding:11px 16px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);border-bottom:1px solid var(--border);background:var(--bg3);text-align:left;">Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var outcomeColor = a.AssignmentStatus == "Completed" ? "var(--green)"
                                          : a.AssignmentStatus == "Declined" ? "var(--red)"
                                          : "var(--orange)"; // Escalated / Superseded
                        <tr>
                            <td style="padding:12px 16px;border-bottom:1px solid var(--border);">
                                <div class="member-name">@(a.Repair.Equipment?.Name)</div>
                                <div class="text-muted" style="font-size:12px;">@(a.Repair.Equipment?.EquipmentCode)</div>
                            </td>
                            <td style="padding:12px 16px;border-bottom:1px solid var(--border);color:var(--text-muted);font-size:12px;">@a.AssignedDate.ToString("dd MMM yyyy")</td>
                            <td style="padding:12px 16px;border-bottom:1px solid var(--border);">
                                <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;background:rgba(0,0,0,.04);color:@outcomeColor;">@a.AssignmentStatus</span>
                            </td>
                            <td style="padding:12px 16px;border-bottom:1px solid var(--border);color:var(--text-sub);font-size:12px;">@a.Repair.RepairStatus</td>
                            <td class="notes-cell" style="padding:12px 16px;border-bottom:1px solid var(--border);">
                                @(a.DeclineReason ?? a.EscalationReason ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
