@model SwiftyS26.Models.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GymHub – Verify Reset Code</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="~/Content/login.css" rel="stylesheet" />
</head>
<body>
    <nav>
        <div class="nav-logo">
            <div class="logo-icon">GH</div>
            <div class="logo-text">Gym<span>Hub</span></div>
        </div>
        <a href="/Forms/ForgotPassword" class="nav-back">← Back</a>
    </nav>

    <div class="login-wrap">
        <div class="login-card">

            <div style="text-align:center;margin-bottom:20px;">
                <div style="width:64px;height:64px;background:rgba(59,130,246,0.15);
                            border:2px solid rgba(59,130,246,0.3);border-radius:50%;
                            display:flex;align-items:center;justify-content:center;
                            margin:0 auto;font-size:28px;">📧</div>
            </div>

            <div class="login-title">VERIFY CODE</div>
            <p class="login-sub">
                We sent a 6-digit reset code to
                <strong style="color:#fff;">@Model.Email</strong>.
                Enter it below to continue.
            </p>

            <div class="otp-sent-msg">
                📧 Reset code sent to <strong>@Model.Email</strong>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-summary">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            @using (Html.BeginForm("VerifyResetCode", "Forms", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Email)

                <div class="form-group" style="margin-bottom:8px;">
                    <label style="text-align:center;display:block;">
                        Enter Your 6-Digit Code *
                    </label>

                    <!-- OTP boxes — purely for UX -->
                    <div class="otp-wrap">
                        <input class="otp-input" type="text" maxlength="1"
                               id="otp1" oninput="otpMove(this,'otp2')"
                               onkeydown="otpBack(event,this,'')" />
                        <input class="otp-input" type="text" maxlength="1"
                               id="otp2" oninput="otpMove(this,'otp3')"
                               onkeydown="otpBack(event,this,'otp1')" />
                        <input class="otp-input" type="text" maxlength="1"
                               id="otp3" oninput="otpMove(this,'otp4')"
                               onkeydown="otpBack(event,this,'otp2')" />
                        <input class="otp-input" type="text" maxlength="1"
                               id="otp4" oninput="otpMove(this,'otp5')"
                               onkeydown="otpBack(event,this,'otp3')" />
                        <input class="otp-input" type="text" maxlength="1"
                               id="otp5" oninput="otpMove(this,'otp6')"
                               onkeydown="otpBack(event,this,'otp4')" />
                        <input class="otp-input" type="text" maxlength="1"
                               id="otp6" oninput="collectOtp()"
                               onkeydown="otpBack(event,this,'otp5')" />
                    </div>

                    @* Hidden field that collects the full OTP *@
                    @Html.HiddenFor(m => m.OtpCode, new { id = "otpHidden" })

                    @Html.ValidationMessageFor(m => m.OtpCode, "",
                        new { @class = "field-error", style = "display:block;text-align:center;" })
                </div>

                <button type="submit" class="btn-login" id="verifyBtn">
                    Verify Code →
                </button>
            }

            <hr class="divider" />
            <div class="login-footer">
                Didn't receive the code?
                <a href="/Forms/ForgotPassword">Request a new one →</a>
            </div>
        </div>
    </div>

    <script>
        function otpMove(current, nextId) {
            current.value = current.value.replace(/\D/g, '');
            if (current.value && nextId)
                document.getElementById(nextId).focus();
            collectOtp();
        }
        function otpBack(e, current, prevId) {
            if (e.key === 'Backspace' && !current.value && prevId)
                document.getElementById(prevId).focus();
        }
        function collectOtp() {
            const otp = ['otp1','otp2','otp3','otp4','otp5','otp6']
                .map(id => document.getElementById(id).value).join('');
            document.getElementById('otpHidden').value = otp;
        }
    </script>
</body>
</html>