<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - GymHub Store Staff Portal</title>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />
    <link rel="apple-touch-icon" href="/Content/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GymHub" />
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function (err) {
                    console.warn('Service worker registration failed:', err);
                });
            });
        }
    </script>

    <style>
        :root {
            --blue: #2563eb;
            --blue-dark: #1d4ed8;
            --blue-light: #eff6ff;
            --blue-mid: #dbeafe;
            --green: #16a34a;
            --green-light: #f0fdf4;
            --red: #dc2626;
            --red-light: #fef2f2;
            --gold: #d97706;
            --gold-light: #fffbeb;
            --purple: #7c3aed;
            --purple-light: #f5f3ff;
            --text-primary: #111111;
            --text-secondary: #555555;
            --text-muted: #aaaaaa;
            --bg: #f0f2f5;
            --bg2: #ffffff;
            --bg3: #f1f5f9;
            --border: #e2e8f0;
            --shadow: 0 8px 40px rgba(0,0,0,.10);
            --radius-sm: 10px;
            --radius-md: 12px;
            --radius-lg: 14px;
            --sidebar-w: 268px;
            --font: 'DM Sans', sans-serif;
            --avatar-bg: linear-gradient(135deg, #f97316, #ea580c);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: var(--font);
            cursor: pointer;
            border: none;
            background: none;
        }

        .layout {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            background: var(--bg2);
            display: flex;
            flex-direction: column;
            height: 100vh;
            position: sticky;
            top: 0;
            overflow-y: auto;
            box-shadow: var(--shadow);
            z-index: 100;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 16px 16px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .logo-box {
            width: 40px;
            height: 40px;
            background: var(--blue);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
            color: #fff;
            flex-shrink: 0;
        }

        .logo-text {
            font-weight: 800;
            font-size: 17px;
            letter-spacing: 1.5px;
            color: var(--text-primary);
        }

        .nav-section {
            padding: 14px 10px 6px;
        }

        .section-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: 0 8px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 13.5px;
            font-weight: 500;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }

            .nav-item:hover {
                background: var(--blue-light);
                color: var(--blue);
            }

            .nav-item.active {
                background: var(--blue-light);
                color: var(--blue);
                font-weight: 600;
            }

            .nav-item svg {
                width: 17px;
                height: 17px;
                flex-shrink: 0;
                opacity: .65;
            }

            .nav-item:hover svg, .nav-item.active svg {
                opacity: 1;
            }

        .nav-divider {
            height: 1px;
            background: var(--border);
            margin: 4px 10px;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 10px;
            border-top: 1px solid var(--border);
            flex-shrink: 0;
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: var(--radius-md);
        }

        .avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--avatar-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
            color: #fff;
            flex-shrink: 0;
        }

        .profile-info {
            flex: 1;
            min-width: 0;
        }

        .profile-name {
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profile-role {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 1px;
        }

        .profile-menu-btn {
            color: var(--text-muted);
            font-size: 18px;
            font-weight: 700;
            padding: 2px 4px;
            border-radius: 6px;
        }

            .profile-menu-btn:hover {
                background: #eee;
            }

        .main-content {
            flex: 1;
            padding: 32px 36px;
            min-width: 0;
            overflow-y: auto;
        }

        .alert {
            padding: 12px 18px;
            border-radius: var(--radius-sm);
            font-size: 13.5px;
            font-weight: 500;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-success {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .alert-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .notif-bell-wrap {
            position: fixed;
            top: 18px;
            right: 28px;
            z-index: 300;
        }

        .notif-bell-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #fff;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 1px 3px rgba(0,0,0,.06);
            position: relative;
            color: var(--text-secondary);
        }

            .notif-bell-btn:hover {
                background: var(--blue-light);
                color: var(--blue);
            }

            .notif-bell-btn svg {
                width: 18px;
                height: 18px;
            }

        .notif-badge {
            position: absolute;
            top: -3px;
            right: -3px;
            min-width: 17px;
            height: 17px;
            padding: 0 4px;
            border-radius: 999px;
            background: var(--red);
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            display: none;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

            .notif-badge.show {
                display: flex;
            }

        .notif-dropdown {
            display: none;
            position: absolute;
            top: 50px;
            right: 0;
            width: 340px;
            max-height: 440px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: 0 10px 40px rgba(0,0,0,.10);
            overflow: hidden;
            flex-direction: column;
        }

            .notif-dropdown.open {
                display: flex;
            }

        .notif-dropdown-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            background: var(--bg3);
            flex-shrink: 0;
        }

        .notif-dropdown-title {
            font-size: 13px;
            font-weight: 700;
        }

        .notif-mark-all {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--blue);
            background: none;
            border: none;
            cursor: pointer;
        }

        .notif-list {
            overflow-y: auto;
            flex: 1;
        }

        .notif-item {
            display: block;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
        }

            .notif-item:last-child {
                border-bottom: none;
            }

            .notif-item:hover {
                background: var(--bg3);
            }

            .notif-item.unread {
                background: var(--blue-light);
            }

        .notif-item-top {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 3px;
        }

        .notif-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--blue);
            flex-shrink: 0;
            margin-top: 5px;
        }

        .notif-item-title {
            font-size: 12.5px;
            font-weight: 700;
            flex: 1;
        }

        .notif-item-time {
            font-size: 10.5px;
            color: var(--text-muted);
            white-space: nowrap;
            flex-shrink: 0;
        }

        .notif-item-msg {
            font-size: 12px;
            color: var(--text-secondary);
            line-height: 1.4;
            padding-left: 15px;
        }

        .notif-empty {
            padding: 40px 20px;
            text-align: center;
            color: var(--text-muted);
            font-size: 12.5px;
        }

            .notif-empty i {
                font-size: 26px;
                opacity: .3;
                display: block;
                margin-bottom: 8px;
            }

        .sidebar-toggle {
            display: none;
            position: fixed;
            top: 14px;
            left: 14px;
            z-index: 200;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--blue);
            color: #fff;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(37,99,235,.35);
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: fixed;
                transform: translateX(calc(-1 * var(--sidebar-w)));
                transition: transform .28s cubic-bezier(.4,0,.2,1);
                height: 100%;
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .sidebar-toggle {
                display: flex;
            }

            .main-content {
                padding: 20px 16px;
                padding-top: 64px;
            }

            .overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.3);
                z-index: 99;
            }

                .overlay.show {
                    display: block;
                }

            .notif-bell-wrap {
                top: 14px;
                right: 14px;
            }

            .notif-dropdown {
                width: calc(100vw - 28px);
                right: -10px;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="layout">

        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Open menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>
        <div class="overlay" id="overlay"></div>

        <div class="notif-bell-wrap">
            <button type="button" class="notif-bell-btn" id="notifBellBtn" aria-label="Notifications">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                <span class="notif-badge" id="notifBadge">0</span>
            </button>
            <div class="notif-dropdown" id="notifDropdown">
                <div class="notif-dropdown-head">
                    <div class="notif-dropdown-title">Notifications</div>
                    <button type="button" class="notif-mark-all" id="notifMarkAllBtn">Mark all as read</button>
                </div>
                <div class="notif-list" id="notifList">
                    <div class="notif-empty"><i class="fas fa-bell-slash"></i>Loading…</div>
                </div>
            </div>
        </div>

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo-box">GH</div>
                <span class="logo-text">GYMHUB</span>
            </div>

            @{ var action = ViewContext.RouteData.Values["action"].ToString(); }

        <nav class="nav-section">
            <div class="section-label">Store Staff</div>

            <a href="@Url.Action("Dashboard", "StoreStaff")" class="nav-item @(action == "Dashboard" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>

            <a href="@Url.Action("Index", "StoreAdmin")" class="nav-item @(action == "Index" ? "active" : "")">
                <i class="fas fa-store"></i> Manage Products
            </a>

            <a href="@Url.Action("Orders", "StoreAdmin")" class="nav-item @(action == "Orders" ? "active" : "")">
                <i class="fas fa-truck-fast"></i> Fulfil Orders
            </a>

            <a href="@Url.Action("UncollectedOrders", "StoreAdmin")" class="nav-item @(action == "UncollectedOrders" ? "active" : "")">
                <i class="fas fa-clock-rotate-left"></i>
                <span>Uncollected Orders</span>
            </a>

            <a href="@Url.Action("ScanPickup", "StoreAdmin")" class="nav-item @(action == "ScanPickup" ? "active" : "")">
                <i class="fas fa-qrcode"></i> Scan for Pickup
            </a>

            <a href="@Url.Action("Returns", "StoreAdmin")" class="nav-item @(action == "Returns" ? "active" : "")">
                <i class="fas fa-rotate-left"></i> Returns
            </a>

            <a href="@Url.Action("Suppliers", "StoreAdmin")" class="nav-item @(action == "Suppliers" ? "active" : "")">
                <i class="fas fa-truck"></i> Suppliers
            </a>

            <a href="@Url.Action("PurchaseOrders", "StoreAdmin")"
               class="nav-item @(action == "PurchaseOrders" ? "active" : "")">
                <i class="fas fa-cart-flatbed"></i>
                <span>Purchase Orders</span>
            </a>

            @{
                bool reportsActive =
                    action == "StoreReports" ||
                    action == "OrderHistory" ||
                    action == "OrderHistoryDetails" ||
                    action == "CollectionHistory" ||
                    action == "CollectionHistoryDetails" ||
                    action == "InventoryMovementHistory";
            }

            <a href="@Url.Action("StoreReports", "StoreAdmin")"
               class="nav-item @(reportsActive ? "active" : "")">
                <i class="fas fa-chart-column"></i>
                <span>Store Reports</span>
            </a>

            <a href="@Url.Action("Promotions", "StoreAdmin")"
               class="nav-item @(action == "Promotions" ? "active" : "")">
                <i class="fas fa-tag"></i>
                <span>Promotions</span>
            </a>
        </nav>

            <div class="nav-divider"></div>

            <nav class="nav-section">
                <div class="section-label">Account</div>
                <a href="@Url.Action("ChangePassword", "StoreStaff")" class="nav-item @(action == "ChangePassword" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    Change Password
                </a>
            </nav>

            <div class="sidebar-footer">
                @{
                    string staffName = ViewBag.StoreStaffName as string ?? "Store Staff";
                    string initials = string.Concat(staffName.Split(' ').Where(w => w.Length > 0).Take(2).Select(w => w[0].ToString().ToUpper()));
                }
                <div class="profile-card">
                    <div class="avatar">@initials</div>
                    <div class="profile-info">
                        <div class="profile-name">@staffName</div>
                        <div class="profile-role">Store Staff</div>
                    </div>
                    @using (Html.BeginForm("Logout", "StoreStaff", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="profile-menu-btn" title="Sign Out">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                        </button>
                    }
                </div>
            </div>
        </aside>

        <main class="main-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <script>
        (function () {
            var sidebar = document.getElementById('sidebar');
            var toggle = document.getElementById('sidebarToggle');
            var overlay = document.getElementById('overlay');
            function openSidebar() { sidebar.classList.add('open'); overlay.classList.add('show'); }
            function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('show'); }
            if (toggle) toggle.addEventListener('click', openSidebar);
            if (overlay) overlay.addEventListener('click', closeSidebar);
        })();

        (function () {
            var bellBtn = document.getElementById('notifBellBtn');
            var dropdown = document.getElementById('notifDropdown');
            var badge = document.getElementById('notifBadge');
            var list = document.getElementById('notifList');
            var markAllBtn = document.getElementById('notifMarkAllBtn');

            function escapeHtml(str) { var d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML; }
            function typeColor(type) {
                switch (type) { case 'Success': return '#16a34a'; case 'Warning': return '#d97706'; case 'Alert': return '#dc2626'; default: return '#2563eb'; }
            }
            function token() { var el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }

            function renderList(notifications) {
                if (!notifications || notifications.length === 0) {
                    list.innerHTML = '<div class="notif-empty"><i class="fas fa-bell-slash"></i>No notifications yet</div>';
                    return;
                }
                list.innerHTML = notifications.map(function (n) {
                    var unreadClass = n.IsRead ? '' : ' unread';
                    return '<a class="notif-item' + unreadClass + '" data-id="' + n.NotificationId + '" data-link="' + escapeHtml(n.LinkUrl || '') + '">' +
                        '<div class="notif-item-top"><span class="notif-dot" style="background:' + typeColor(n.Type) + '"></span>' +
                        '<span class="notif-item-title">' + escapeHtml(n.Title) + '</span>' +
                        '<span class="notif-item-time">' + escapeHtml(n.timeAgo) + '</span></div>' +
                        '<div class="notif-item-msg">' + escapeHtml(n.Message) + '</div></a>';
                }).join('');
                Array.from(list.querySelectorAll('.notif-item')).forEach(function (el) {
                    el.addEventListener('click', function () {
                        var id = this.getAttribute('data-id'); var link = this.getAttribute('data-link');
                        markAsRead(id); if (link) window.location.href = link;
                    });
                });
            }

            function refresh() {
                fetch('/Notification/GetRecent', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) return;
                        renderList(data.notifications);
                        if (data.unreadCount > 0) { badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount; badge.classList.add('show'); }
                        else { badge.classList.remove('show'); }
                    }).catch(function () { });
            }

            function markAsRead(id) {
                var fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', token());
                fetch('/Notification/MarkAsRead', { method: 'POST', body: fd, credentials: 'same-origin' }).then(function () { refresh(); }).catch(function () { });
            }

            markAllBtn.addEventListener('click', function () {
                var fd = new FormData(); fd.append('__RequestVerificationToken', token());
                fetch('/Notification/MarkAllAsRead', { method: 'POST', body: fd, credentials: 'same-origin' }).then(function () { refresh(); }).catch(function () { });
            });

            bellBtn.addEventListener('click', function (e) { e.stopPropagation(); dropdown.classList.toggle('open'); if (dropdown.classList.contains('open')) refresh(); });
            document.addEventListener('click', function (e) { if (!dropdown.contains(e.target) && e.target !== bellBtn) dropdown.classList.remove('open'); });

            refresh();
            setInterval(refresh, 30000);
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
