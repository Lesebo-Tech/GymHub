@model SwiftyS26.Models.Technician
@{
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
    ViewBag.Title = "Dashboard";

    string technicianName = ViewBag.TechnicianName as string ?? "";
    string technicianRole = ViewBag.TechnicianRole as string ?? "Technician";
    string technicianCode = ViewBag.TechnicianCode as string ?? "";
    string specialization = ViewBag.Specialization as string ?? "General";
    string certificationLevel = ViewBag.CertificationLevel as string ?? "";
    string employmentType = ViewBag.EmploymentType as string ?? "";

    int hour = DateTime.Now.Hour;
    string greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .db-wrap {
            max-width: 1140px;
        }

        .db-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .db-header-left h1 {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0 0 2px;
        }

        .db-header-left p {
            font-size: 13px;
            color: var(--muted);
            margin: 0;
        }

        .db-header-right {
            font-size: 13px;
            color: var(--muted);
        }

            .db-header-right strong {
                color: var(--text-primary);
                font-weight: 700;
            }

        .stat-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .sc {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px 20px 18px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            transition: box-shadow 0.2s, transform 0.2s;
        }

            .sc:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.06);
            }

        .sc-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

            .sc-icon.blue {
                background: #eff6ff;
                color: #2563eb;
            }

            .sc-icon.green {
                background: #f0fdf4;
                color: #16a34a;
            }

            .sc-icon.orange {
                background: #fff7ed;
                color: #ea580c;
            }

            .sc-icon.purple {
                background: #faf5ff;
                color: #7c3aed;
            }

        .sc-label {
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: var(--muted);
            margin-bottom: 4px;
        }

        .sc-value {
            font-size: 30px;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1;
            margin-bottom: 4px;
        }

            .sc-value.text-val {
                font-size: 15px;
                font-weight: 700;
            }

        .sc-sub {
            font-size: 12px;
            color: var(--muted);
        }

        .sec-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
        }

        .sec-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
        }

        .sec-card-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .sec-card-title i {
                color: var(--muted);
                font-size: 13px;
            }

        .empty {
            text-align: center;
            padding: 48px 20px;
            color: var(--muted);
        }

            .empty i {
                font-size: 32px;
                margin-bottom: 12px;
                opacity: 0.35;
                display: block;
            }

            .empty p {
                font-size: 13px;
                margin: 0;
            }

        @@media (max-width: 1000px) {
            .stat-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 420px) {
            .stat-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="db-wrap">

    <!-- Header -->
    <div class="db-header">
        <div class="db-header-left">
            <h1>Dashboard</h1>
        </div>
        <div class="db-header-right">
            @greeting, <strong>@technicianName</strong> — @technicianCode · @specialization · @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </div>
    </div>
    <!-- Stat cards -->
    <div class="stat-row">
        <div class="sc">
            <div class="sc-icon blue"><i class="fas fa-inbox"></i></div>
            <div>
                <div class="sc-label">Awaiting Response</div>
                <div class="sc-value">@ViewBag.AwaitingResponseCount</div>
                <div class="sc-sub">New assignments to accept</div>
            </div>
        </div>
        <div class="sc">
            <div class="sc-icon orange"><i class="fas fa-wrench"></i></div>
            <div>
                <div class="sc-label">In Progress</div>
                <div class="sc-value">@ViewBag.InProgressCount</div>
                <div class="sc-sub">Currently working on</div>
            </div>
        </div>
        <div class="sc">
            <div class="sc-icon purple"><i class="fas fa-hourglass-half"></i></div>
            <div>
                <div class="sc-label">Awaiting Inspection</div>
                <div class="sc-value">@ViewBag.AwaitingInspectionCount</div>
                <div class="sc-sub">Completed, pending sign-off</div>
            </div>
        </div>
        <div class="sc">
            <div class="sc-icon green"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="sc-label">Completed This Month</div>
                <div class="sc-value">@ViewBag.CompletedThisMonthCount</div>
                <div class="sc-sub">@DateTime.Now.ToString("MMMM yyyy")</div>
            </div>
        </div>
    </div>

    <!-- Assigned Work -->
    <div class="sec-card">
        <div class="sec-card-head">
            <div class="sec-card-title"><i class="fas fa-clipboard-list"></i> Recent Assignments</div>
            <a href="@Url.Action("MyRepairs", "Technician")" class="card-action-btn">View All <i class="fas fa-arrow-right"></i></a>
        </div>
        @{
            var recent = ViewBag.RecentAssignments as List<SwiftyS26.Models.RepairAssignment>;
        }
        @if (recent == null || !recent.Any())
        {
            <div class="empty">
                <i class="fas fa-clipboard-check"></i>
                <p>No open assignments right now.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table style="width:100%;border-collapse:collapse;font-size:13px;">
                    <tbody>
                        @foreach (var a in recent)
                        {
                            <tr>
                                <td style="padding:14px 20px;border-bottom:1px solid var(--border);">
                                    <div class="member-name">@(a.Repair.Equipment?.Name)</div>
                                    <div class="text-muted" style="font-size:12px;">@(a.Repair.Equipment?.EquipmentCode) — @a.Repair.FaultDescription</div>
                                </td>
                                <td style="padding:14px 20px;border-bottom:1px solid var(--border);color:var(--text-muted);font-size:12px;">@a.Priority priority</td>
                                <td style="padding:14px 20px;border-bottom:1px solid var(--border);">
                                    <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;background:var(--blue-light);color:var(--blue);">@a.AssignmentStatus</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>