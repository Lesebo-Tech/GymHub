@model SwiftyS26.Models.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GymHub – Reset Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="~/Content/login.css" rel="stylesheet" />
</head>
<body>
    <nav>
        <div class="nav-logo">
            <div class="logo-icon">GH</div>
            <div class="logo-text">Gym<span>Hub</span></div>
        </div>
        <a href="/Forms/Login" class="nav-back">← Back to Sign In</a>
    </nav>

    <div class="login-wrap">
        <div class="login-card">

            <div style="text-align:center;margin-bottom:20px;">
                <div style="width:64px;height:64px;background:rgba(34,197,94,0.15);
                            border:2px solid rgba(34,197,94,0.3);border-radius:50%;
                            display:flex;align-items:center;justify-content:center;
                            margin:0 auto;font-size:28px;"></div>
            </div>

            <div class="login-title">NEW PASSWORD</div>
            <p class="login-sub">
                Code verified! Now create your new password for
                <strong style="color:#fff;">@Model.Email</strong>.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-summary">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            @using (Html.BeginForm("ResetPassword", "Forms", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Email)
                @Html.HiddenFor(m => m.OtpCode)

                <div class="form-group">
                    <label>New Password *</label>
                    <div class="input-wrap">
                        @Html.PasswordFor(m => m.NewPassword, new
                        {
                            id = "newPassword",
                            placeholder = "Create a new strong password"
                        })
                        <span class="input-badge" id="pw1Toggle"
                              onclick="togglePass('newPassword','pw1Toggle')"
                              style="pointer-events:auto;cursor:pointer;">👁</span>
                    </div>
                    <div class="field-hint">
                        Min 8 characters, 1 uppercase, 1 number, 1 special character
                    </div>
                    @Html.ValidationMessageFor(m => m.NewPassword, "",
                        new { @class = "field-error", style = "display:block;" })
                </div>

                <div class="form-group">
                    <label>Confirm New Password *</label>
                    <div class="input-wrap">
                        @Html.PasswordFor(m => m.ConfirmPassword, new
                        {
                            id = "confirmPassword",
                            placeholder = "Repeat your new password"
                        })
                        <span class="input-badge" id="pw2Toggle"
                              onclick="togglePass('confirmPassword','pw2Toggle')"
                              style="pointer-events:auto;cursor:pointer;">👁</span>
                    </div>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "",
                        new { @class = "field-error", style = "display:block;" })
                </div>

                <button type="submit" class="btn-login">
                    Reset Password →
                </button>
            }

            <hr class="divider" />
            <div class="login-footer">
                Remembered it?
                <a href="/Forms/Login">Back to Sign In →</a>
            </div>
        </div>
    </div>

    <script>
        function togglePass(inputId, btnId) {
            const input = document.getElementById(inputId);
            const btn = document.getElementById(btnId);
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            btn.textContent = input.type === 'password' ? '👁' : '🙈';
        }
    </script>
</body>
</html>