@model List<SwiftyS26.Models.Equipment>
@using System.Web
@{
    Layout = "~/Views/Shared/_TechnicianLayout.cshtml";
    ViewBag.PageTitle = "My Maintenance";
    var equipmentList = Model ?? new List<SwiftyS26.Models.Equipment>();
    var allActiveEquipment = ViewBag.AllActiveEquipment as List<SwiftyS26.Models.Equipment> ?? new List<SwiftyS26.Models.Equipment>();
}

<div class="pg-header" style="margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
    <h2 style="font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1.5px;">MY MAINTENANCE</h2>
    <button type="button" onclick="openLogModal()" style="padding:10px 20px;background:#fff;color:#334155;border:1px solid #e2e8f0;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;">
        <i class="fas fa-plus"></i> Log Ad-Hoc Maintenance
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#f0fdf4;color:#16a34a;border:1px solid rgba(22,163,74,.2);padding:12px 16px;border-radius:8px;margin-bottom:16px;font-weight:600;font-size:13px;">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#fef2f2;color:#dc2626;border:1px solid rgba(220,38,38,.2);padding:12px 16px;border-radius:8px;margin-bottom:16px;font-weight:600;font-size:13px;">
        @TempData["Error"]
    </div>
}

@if (!equipmentList.Any())
{
    <div style="text-align:center;padding:48px;color:#64748b;background:#fff;border:1px solid #e2e8f0;border-radius:12px;">
        <i class="fas fa-check-circle" style="font-size:32px;opacity:.3;display:block;margin-bottom:12px;"></i>
        No maintenance currently assigned to you.
    </div>
}
else
{
    foreach (var e in equipmentList)
    {
        int daysOverdue = e.NextMaintenanceDueDate.HasValue ? (DateTime.Today - e.NextMaintenanceDueDate.Value).Days : 0;
        bool isOverdue = daysOverdue > 0;
        bool isDueToday = daysOverdue == 0;

        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
            <div>
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                    <div style="font-weight:700;font-size:15px;">@e.Name</div>
                    @if (isOverdue)
                    {
                        <span style="padding:3px 10px;border-radius:20px;font-size:10.5px;font-weight:700;text-transform:uppercase;background:#fef2f2;color:#dc2626;">@daysOverdue day@(daysOverdue == 1 ? "" : "s") overdue</span>
                    }
                    else if (isDueToday)
                    {
                        <span style="padding:3px 10px;border-radius:20px;font-size:10.5px;font-weight:700;text-transform:uppercase;background:#fffbeb;color:#d97706;">Due today</span>
                    }
                </div>
                <div style="font-size:12px;color:#64748b;">@e.EquipmentCode — @e.GymArea</div>
                <div style="font-size:12px;color:#64748b;margin-top:4px;">
                    <i class="fas fa-calendar"></i> Due: @(e.NextMaintenanceDueDate?.ToString("dd MMM yyyy") ?? "—")
                    @if (e.PendingMaintenanceAssignedDate.HasValue)
                    {
                        <span> · Assigned @e.PendingMaintenanceAssignedDate.Value.ToString("dd MMM yyyy")</span>
                    }
                </div>
            </div>
            <button type="button" onclick="openPerformModal(@e.EquipmentId, '@Html.Raw(HttpUtility.JavaScriptStringEncode(e.Name))', '@e.EquipmentCode')"
                    style="padding:10px 20px;background:#16a34a;color:#fff;border:none;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;white-space:nowrap;">
                <i class="fas fa-oil-can"></i> Perform Maintenance
            </button>
        </div>
    }
}

<!-- ===== PERFORM MAINTENANCE MODAL (assigned/due) ===== -->
<div id="performModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:14px;padding:26px;max-width:460px;width:90%;">
        <div style="font-weight:700;font-size:16px;margin-bottom:4px;">Perform Maintenance</div>
        <p style="font-size:13px;color:#64748b;margin-bottom:16px;">
            <span id="performEquipName"></span> (<span id="performEquipCode"></span>)
        </p>
        @using (Html.BeginForm("PerformMaintenance", "Maintenance", FormMethod.Post, new { id = "performForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="equipmentId" id="perform_EquipmentId" />
            <input type="hidden" name="technicianId" value="@ViewBag.TechnicianId" />

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Result <span style="color:#dc2626;">*</span></label>
                <select name="result" required style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;">
                    <option value="">Select</option>
                    <option value="Completed">Completed — No Issues</option>
                    <option value="IssueFound">Issue Found</option>
                </select>
            </div>

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Tasks Performed</label>
                <textarea name="tasksPerformed" style="width:100%;min-height:70px;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;" placeholder="e.g. Lubricated chain, tightened bolts, cleaned belt"></textarea>
            </div>

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Parts Replaced</label>
                <input name="partsReplaced" style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;" placeholder="Optional" />
            </div>

            <div style="margin-bottom:16px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Cost (R)</label>
                <input name="cost" type="number" step="0.01" min="0" style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;" />
            </div>

            <div style="display:flex;gap:10px;">
                <button type="submit" style="flex:1;padding:11px;background:#16a34a;color:#fff;border:none;border-radius:8px;font-weight:700;cursor:pointer;">Submit</button>
                <button type="button" onclick="closePerformModal()" style="flex:1;padding:11px;background:transparent;border:1px solid #e2e8f0;border-radius:8px;font-weight:700;cursor:pointer;">Cancel</button>
            </div>
        }
    </div>
</div>

<!-- ===== LOG AD-HOC MAINTENANCE MODAL (unscheduled) ===== -->
<div id="logModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:14px;padding:26px;max-width:460px;width:90%;">
        <div style="font-weight:700;font-size:16px;margin-bottom:4px;">Log Ad-Hoc Maintenance</div>
        <p style="font-size:13px;color:#64748b;margin-bottom:16px;">For work done outside the scheduled cycle — pick any equipment.</p>
        @using (Html.BeginForm("LogMaintenance", "Maintenance", FormMethod.Post, new { id = "logForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="technicianId" value="@ViewBag.TechnicianId" />

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Equipment <span style="color:#dc2626;">*</span></label>
                <select name="equipmentId" required style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;">
                    <option value="">Select equipment</option>
                    @foreach (var e in allActiveEquipment)
                    {
                        <option value="@e.EquipmentId">@e.Name (@e.EquipmentCode) — @e.GymArea</option>
                    }
                </select>
            </div>

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Result <span style="color:#dc2626;">*</span></label>
                <select name="result" required style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;">
                    <option value="">Select</option>
                    <option value="Completed">Completed — No Issues</option>
                    <option value="IssueFound">Issue Found</option>
                </select>
            </div>

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Tasks Performed</label>
                <textarea name="tasksPerformed" style="width:100%;min-height:70px;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;" placeholder="What did you notice/do while working nearby"></textarea>
            </div>

            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Parts Replaced</label>
                <input name="partsReplaced" style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;" placeholder="Optional" />
            </div>

            <div style="margin-bottom:16px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:5px;">Cost (R)</label>
                <input name="cost" type="number" step="0.01" min="0" style="width:100%;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit;font-size:13px;" />
            </div>

            <div style="display:flex;gap:10px;">
                <button type="submit" style="flex:1;padding:11px;background:#334155;color:#fff;border:none;border-radius:8px;font-weight:700;cursor:pointer;">Log Maintenance</button>
                <button type="button" onclick="closeLogModal()" style="flex:1;padding:11px;background:transparent;border:1px solid #e2e8f0;border-radius:8px;font-weight:700;cursor:pointer;">Cancel</button>
            </div>
        }
    </div>
</div>

<script>
    function openPerformModal(equipmentId, equipName, equipCode) {
        document.getElementById('perform_EquipmentId').value = equipmentId;
        document.getElementById('performEquipName').textContent = equipName;
        document.getElementById('performEquipCode').textContent = equipCode;
        document.getElementById('performModal').style.display = 'flex';
    }
    function closePerformModal() { document.getElementById('performModal').style.display = 'none'; }

    function openLogModal() { document.getElementById('logModal').style.display = 'flex'; }
    function closeLogModal() { document.getElementById('logModal').style.display = 'none'; }
</script>
