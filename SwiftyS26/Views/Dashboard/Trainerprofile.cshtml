@model SwiftyS26.Models.Trainer
@using SwiftyS26.Models

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewBag.ActivePage = "trainer";
    ViewBag.PageTitle = "Trainer Profile";

    bool isMatch = ViewBag.IsMatch != null ? (bool)ViewBag.IsMatch : false;
    bool alreadyAssigned = ViewBag.AlreadyAssigned != null ? (bool)ViewBag.AlreadyAssigned : false;
    bool atCapacity = ViewBag.AtCapacity != null ? (bool)ViewBag.AtCapacity : false;
    string memberGoal = ViewBag.MemberGoal as string ?? "";
    int currentLoad = ViewBag.CurrentLoad != null ? (int)ViewBag.CurrentLoad : 0;

    string initials = "";
    if (!string.IsNullOrEmpty(Model.FullName))
    {
        foreach (var part in Model.FullName.Split(' '))
        { if (!string.IsNullOrWhiteSpace(part)) { initials += part[0]; } }
    }

    int capPct = Model.MaxCapacity > 0
        ? (int)Math.Round(((double)currentLoad / Model.MaxCapacity) * 100)
        : 0;

    string capColor = capPct >= 90 ? "#dc2626" : capPct >= 60 ? "#d97706" : "#2563eb";

    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

    var availabilities = Model.Availabilities != null
        ? Model.Availabilities.Where(a => a.IsAvailable).ToList()
        : new List<TrainerAvailability>();
}

@section head {
    <style>
        .tp-page {
            max-width: 900px;
            margin: 0 auto;
        }

        .tp-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #6b7280;
            text-decoration: none;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            padding: 7px 13px;
            margin-bottom: 18px;
            background: #fff;
            transition: background .15s;
        }

            .tp-back:hover {
                background: #f5f6fa;
                color: #111827;
            }

        /* Goal match box */
        .goal-box {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 14px;
            padding: 12px 16px;
            margin-bottom: 16px;
            font-size: 13px;
            color: #d97706;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .goal-box strong {
                color: #92400e;
            }

        /* Cards */
        .tp-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
            padding: 24px 28px;
            margin-bottom: 16px;
        }

        /* Hero top */
        .trainer-top {
            display: flex;
            gap: 22px;
            flex-wrap: wrap;
        }

        .trainer-avatar {
            width: 86px;
            height: 86px;
            border-radius: 50%;
            background: #eff6ff;
            border: 2.5px solid #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            color: #2563eb;
            flex-shrink: 0;
        }

        .trainer-name {
            font-size: 24px;
            font-weight: 700;
            color: #111827;
            letter-spacing: -.3px;
        }

        .trainer-meta {
            font-size: 13px;
            color: #6b7280;
            margin-top: 4px;
        }

        .badges {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
            margin-top: 12px;
        }

        .badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
        }

            .badge.match {
                background: #fffbeb;
                color: #d97706;
                border-color: #fde68a;
            }

        .contact-row {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-top: 14px;
            font-size: 13px;
            color: #6b7280;
        }

        .action-row {
            margin-top: 20px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-primary {
            background: #2563eb;
            color: #fff;
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 600;
            padding: 10px 22px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: background .15s;
        }

            .btn-primary:hover {
                background: #1d4ed8;
            }

        .btn-ghost {
            background: transparent;
            border: 1px solid #d1d5db;
            color: #6b7280;
            font-family: inherit;
            font-size: 13.5px;
            padding: 9px 18px;
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: background .15s;
        }

            .btn-ghost:hover {
                background: #f5f6fa;
            }

        /* Section title */
        .section-title {
            font-size: 15px;
            font-weight: 600;
            color: #111827;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section-icon {
            width: 28px;
            height: 28px;
            background: #eff6ff;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .section-icon svg {
                width: 14px;
                height: 14px;
                stroke: #2563eb;
                fill: none;
                stroke-width: 2;
            }

        /* Info grid */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 18px;
        }

        .info-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #9ca3af;
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 14.5px;
            font-weight: 500;
            color: #111827;
        }

        /* Capacity */
        .cap-section {
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px solid #e5e7eb;
        }

        .cap-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 7px;
            font-size: 12px;
            color: #6b7280;
        }

            .cap-row span:last-child {
                font-weight: 600;
                color: #111827;
            }

        .cap-bar {
            height: 6px;
            background: #f5f6fa;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            overflow: hidden;
        }

        .cap-fill {
            height: 100%;
            border-radius: 999px;
            transition: width .4s ease;
        }

        /* Availability grid */
        .avail-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 8px;
        }

        .avail-item {
            background: #f5f6fa;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 11px 6px;
            text-align: center;
        }

            .avail-item.on {
                background: #eff6ff;
                border-color: #bfdbfe;
            }

        .avail-day {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #9ca3af;
            margin-bottom: 6px;
        }

        .avail-item.on .avail-day {
            color: #2563eb;
        }

        .avail-time {
            font-size: 11px;
            color: #6b7280;
            line-height: 1.5;
        }

        .avail-item.on .avail-time {
            color: #111827;
            font-weight: 500;
        }

        .avail-off {
            font-size: 12px;
            color: #9ca3af;
        }

        @@media (max-width: 600px) {
            .avail-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }
    </style>
}

<div class="tp-page">

    <a href="@Url.Action("FindTrainer","Dashboard")" class="tp-back">← Back</a>

    @if (isMatch && !string.IsNullOrEmpty(memberGoal))
    {
        <div class="goal-box">
            ⭐ Great match for your goal: <strong>@memberGoal</strong>
        </div>
    }

    <!-- Hero card -->
    <div class="tp-card">
        <div class="trainer-top">
            <div class="trainer-avatar">@initials</div>
            <div style="flex:1;">
                <div class="trainer-name">@Model.FullName</div>
                <div class="trainer-meta">@Model.TrainerCode &bull; @Model.Role</div>

                <div class="badges">
                    @if (isMatch)
                    {<div class="badge match">⭐ Best Match</div>}
                    <div class="badge">@Model.Specialization</div>
                    <div class="badge">@Model.ExperienceLevel</div>
                    <div class="badge">@Model.Qualification</div>
                </div>

                <div class="contact-row">
                    <span>📞 @Model.PhoneNumber</span>
                    <span>📧 @Model.Email</span>
                </div>

                <div class="action-row">
                    @if (alreadyAssigned)
                    {
                        <span style="font-size:13px;color:#9ca3af;">You already have a trainer assigned.</span>
                    }
                    else if (atCapacity)
                    {
                        <span style="font-size:13px;color:#dc2626;font-weight:500;">This trainer is at full capacity.</span>
                    }
                    else
                    {
                        using (Html.BeginForm("RequestTrainer", "MemberTrainer", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="trainerId" value="@Model.TrainerId" />
                            <button type="submit" class="btn-primary">Book This Trainer</button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Professional details -->
    <div class="tp-card">
        <div class="section-title">
            <div class="section-icon">
                <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 3h-2a2 2 0 0 0-4 0H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z" /></svg>
            </div>
            Professional Details
        </div>

        <div class="info-grid">
            <div><div class="info-label">Specialization</div><div class="info-value">@Model.Specialization</div></div>
            <div><div class="info-label">Experience Level</div><div class="info-value">@Model.ExperienceLevel</div></div>
            <div><div class="info-label">Qualification</div><div class="info-value">@Model.Qualification</div></div>
            <div><div class="info-label">Employment Type</div><div class="info-value">@Model.EmploymentType</div></div>
            <div><div class="info-label">Capacity</div><div class="info-value">@currentLoad / @Model.MaxCapacity</div></div>
            <div><div class="info-label">Gender</div><div class="info-value">@(string.IsNullOrEmpty(Model.Gender) ? "-" : Model.Gender)</div></div>
        </div>

        <div class="cap-section">
            <div class="cap-row">
                <span>Trainer Capacity</span>
                <span>@currentLoad / @Model.MaxCapacity members</span>
            </div>
            <div class="cap-bar">
                <div class="cap-fill" style="width:@(capPct); background:@capColor;"></div>
            </div>
        </div>
    </div>

    <!-- Availability -->
    <div class="tp-card">
        <div class="section-title">
            <div class="section-icon">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            </div>
            Weekly Availability
        </div>

        <div class="avail-grid">
            @foreach (var day in days)
            {
                var item = availabilities.FirstOrDefault(x => x.DayOfWeek == day);
                <div class="avail-item @(item != null ? "on" : "")">
                    <div class="avail-day">@day.Substring(0, 3)</div>
                    @if (item != null)
                    {
                        <div class="avail-time">@item.StartTime<br />@item.EndTime</div>
                    }
                    else
                    {
                        <div class="avail-off">Off</div>
                    }
                </div>
            }
        </div>
    </div>

</div>