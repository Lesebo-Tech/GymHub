@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewBag.PageTitle = "Checkout";
    var cartItems = ViewBag.CartItems as List<SwiftyS26.Models.ShoppingCartItem>;
    decimal subtotal = ViewBag.Subtotal;
    decimal discount = ViewBag.Discount;
    decimal finalTotal = ViewBag.FinalTotal;
    bool isPremium = ViewBag.IsPremium;
}

<style>
    @@keyframes co-fadeUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes co-pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.04);
        }
    }

    @@keyframes co-shimmer {
        0% {
            background-position: -200px 0;
        }

        100% {
            background-position: 200px 0;
        }
    }

    .co-wrap {
        max-width: 640px;
        margin: 0 auto;
        animation: co-fadeUp .4s ease both;
    }

    .co-header {
        margin-bottom: 20px;
    }

        .co-header h2 {
            font-family: 'Bebas Neue',sans-serif;
            font-size: 26px;
            letter-spacing: 1px;
            color: #0F172A;
        }

    .co-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,.07);
        border-radius: 16px;
        padding: 22px;
        margin-bottom: 18px;
        animation: co-fadeUp .45s ease both;
    }

        .co-card:nth-child(2) {
            animation-delay: .05s;
        }

        .co-card:nth-child(3) {
            animation-delay: .1s;
        }

    .co-item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid rgba(0,0,0,.05);
        transition: background .2s;
    }

        .co-item-row:last-child {
            border-bottom: none;
        }

        .co-item-row:hover {
            background: #FAFBFF;
        }

    .co-item-name {
        font-size: 13.5px;
        font-weight: 600;
        color: #0F172A;
    }

    .co-item-qty {
        font-size: 12px;
        color: #64748B;
        margin-top: 2px;
    }

    .co-item-price {
        font-weight: 700;
        color: #0F172A;
        font-size: 14px;
    }

    .co-premium-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg,#F59E0B,#D97706);
        color: #fff;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 14px;
        animation: co-pulse 2.2s ease-in-out infinite;
        box-shadow: 0 4px 14px rgba(217,119,6,.35);
    }

    .co-summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 13.5px;
        color: #334155;
        margin-bottom: 10px;
    }

        .co-summary-row.discount {
            color: #16A34A;
            font-weight: 700;
        }

        .co-summary-row.total {
            font-size: 19px;
            font-weight: 800;
            color: #0F172A;
            border-top: 1px dashed rgba(0,0,0,.12);
            padding-top: 14px;
            margin-top: 6px;
        }

    .co-pay-btn {
        display: block;
        width: 100%;
        padding: 15px;
        margin-top: 18px;
        background: linear-gradient(135deg,#2563EB,#1D4ED8);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 800;
        font-size: 15px;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(37,99,235,.35);
        transition: transform .15s, box-shadow .15s;
        position: relative;
        overflow: hidden;
    }

        .co-pay-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(37,99,235,.45);
        }

        .co-pay-btn:disabled {
            background: linear-gradient(90deg, #94A3B8 0%, #B4BFCC 50%, #94A3B8 100%);
            background-size: 400px 100%;
            animation: co-shimmer 1.4s linear infinite;
            cursor: not-allowed;
        }

    .co-secure-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 11.5px;
        color: #94A3B8;
        margin-top: 12px;
    }

    @@media (max-width: 640px) {
        .co-wrap {
            padding: 0 4px;
        }

        .co-card {
            padding: 16px;
            border-radius: 14px;
        }

        .co-header h2 {
            font-size: 22px;
        }

        .co-summary-row.total {
            font-size: 17px;
        }

        .co-pay-btn {
            padding: 14px;
            font-size: 14px;
        }
    }
</style>

<div class="co-wrap">
    <div class="co-header"><h2><i class="fas fa-lock" style="color:#2563EB; margin-right:8px;"></i>Checkout</h2></div>

    @if (TempData["Error"] != null)
    {
        <div style="background:#FEF2F2;color:#DC2626;border:1px solid rgba(220,38,38,.2);padding:12px 16px;border-radius:10px;margin-bottom:16px;font-size:13px;font-weight:600;">@TempData["Error"]</div>
    }

<div class="co-card">
    <div style="font-weight:700;font-size:14px;margin-bottom:14px;color:#0F172A;">Order Summary</div>
    @foreach (var item in cartItems)
    {
        decimal itemLineTotal = item.Product != null ? item.Product.DisplayPrice * item.Quantity : 0;
        <div class="co-item-row">
            <div>
                <div class="co-item-name">@(item.Product?.Name)</div>
                <div class="co-item-qty">
                    Qty: @item.Quantity
                    @if (item.Product != null && item.Product.IsOnPromotion)
                    {
                        <span style="color:#7C3AED; font-weight:700;"> · @(item.Product.ActivePromotion?.DiscountPercent)% off</span>
                    }
                </div>
            </div>
            <div class="co-item-price">R@(itemLineTotal.ToString("F2"))</div>
        </div>
    }
</div>

    <div class="co-card">
        @if (isPremium)
        {
            <span class="co-premium-badge"><i class="fas fa-star"></i> Premium Member Discount Applied</span>
        }
        <div class="co-summary-row"><span>Subtotal</span><span>R@(subtotal.ToString("F2"))</span></div>
        @if (discount > 0)
        {
            <div class="co-summary-row discount"><span>Premium Discount</span><span>-R@(discount.ToString("F2"))</span></div>
        }
        <div class="co-summary-row total"><span>Total</span><span>R@(finalTotal.ToString("F2"))</span></div>

        @using (Html.BeginForm("InitiatePayment", "Store", FormMethod.Post, new { id = "checkoutForm" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="co-pay-btn" id="payBtn"><i class="fas fa-credit-card"></i> Pay R@(finalTotal.ToString("F2")) with Paystack</button>
        }
        <div class="co-secure-note"><i class="fas fa-shield-halved"></i> Secured by Paystack</div>
    </div>
</div>

<script>
    document.getElementById('checkoutForm').addEventListener('submit', function () {
        var btn = document.getElementById('payBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Redirecting to Paystack...';
    });
</script>