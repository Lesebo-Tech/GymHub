@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewBag.PageTitle = "Nutrition Tracker";
    ViewBag.ActivePage = "nutrition";
}

<style>
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes softPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(37,99,235,.18);
        }

        50% {
            box-shadow: 0 0 0 10px rgba(37,99,235,0);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -300px 0;
        }

        100% {
            background-position: 300px 0;
        }
    }

    @@keyframes spinSlow {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes checkPop {
        0% {
            transform: scale(0);
            opacity: 0;
        }

        60% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes stepGlow {
        0%, 100% {
            opacity: .4;
        }

        50% {
            opacity: 1;
        }
    }

    .nt-wrap {
        max-width: 560px;
        margin: 0 auto;
        animation: fadeSlideUp .45s cubic-bezier(.2,.7,.3,1) both;
    }

    .meal-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.07);
        border-radius: 20px;
        padding: 36px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06), 0 1px 4px rgba(0,0,0,.03);
        position: relative;
        overflow: hidden;
    }
        /* soft decorative gradient blob, purely cosmetic */
        .meal-card::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 220px;
            height: 220px;
            background: radial-gradient(circle, rgba(37,99,235,.10), transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

    .meal-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 6px;
        position: relative;
    }

    .meal-card-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        background: linear-gradient(135deg, #3B82F6, #1D4ED8);
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
        box-shadow: 0 6px 16px rgba(37,99,235,.35);
    }

    .meal-card h2 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 25px;
        letter-spacing: 1px;
        color: #0F172A;
        line-height: 1.1;
    }

    .meal-card p {
        font-size: 13px;
        color: #64748B;
        margin: 4px 0 26px;
        position: relative;
    }

    .meal-form-group {
        margin-bottom: 22px;
        position: relative;
    }

        .meal-form-group > label {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            color: #0F172A;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

    /* ── Segmented meal-type control (visual layer over a real <select>) ── */
    .meal-type-seg {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        background: #F1F5F9;
        border-radius: 12px;
        padding: 5px;
        position: relative;
    }

    .meal-type-option {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        padding: 10px 4px;
        border-radius: 9px;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: #64748B;
        transition: color .22s ease;
        text-align: center;
        user-select: none;
    }

        .meal-type-option i {
            font-size: 15px;
            transition: transform .25s cubic-bezier(.34,1.56,.64,1);
        }

        .meal-type-option.active {
            color: #1D4ED8;
        }

            .meal-type-option.active i {
                transform: translateY(-1px) scale(1.1);
            }

    .meal-type-seg-bg {
        position: absolute;
        top: 5px;
        bottom: 5px;
        left: 5px;
        width: calc(25% - 6px);
        background: #fff;
        border-radius: 9px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        transition: transform .28s cubic-bezier(.34,1.56,.64,1);
        z-index: 0;
    }

    #mealType {
        display: none;
    }
    /* real select stays in the DOM & form, just visually hidden */

    /* ── Drag & drop photo zone ── */
    .dropzone {
        border: 2px dashed #CBD5E1;
        border-radius: 14px;
        background: #F8FAFC;
        padding: 28px 20px;
        text-align: center;
        cursor: pointer;
        transition: border-color .2s ease, background .2s ease, transform .15s ease;
        position: relative;
    }

        .dropzone:hover {
            border-color: #93C5FD;
            background: #F0F6FF;
        }

        .dropzone.dragover {
            border-color: #2563EB;
            background: #EFF6FF;
            transform: scale(1.01);
            animation: softPulse 1.4s ease infinite;
        }

        .dropzone.has-file {
            padding: 14px;
            border-style: solid;
            border-color: #BFDBFE;
        }

    .dropzone-icon {
        width: 46px;
        height: 46px;
        margin: 0 auto 10px;
        border-radius: 50%;
        background: #EFF6FF;
        color: #2563EB;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        transition: transform .2s ease;
    }

    .dropzone.dragover .dropzone-icon {
        transform: scale(1.12) rotate(-4deg);
    }

    .dropzone-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #0F172A;
        margin-bottom: 3px;
    }

    .dropzone-sub {
        font-size: 11.5px;
        color: #94A3B8;
    }

        .dropzone-sub strong {
            color: #2563EB;
        }

    .dropzone-preview {
        display: none;
        align-items: center;
        gap: 14px;
        text-align: left;
    }

        .dropzone-preview img {
            width: 72px;
            height: 72px;
            object-fit: cover;
            border-radius: 10px;
            flex-shrink: 0;
            box-shadow: 0 3px 10px rgba(0,0,0,.12);
            animation: fadeSlideUp .3s ease both;
        }

    .dropzone-preview-info {
        flex: 1;
        min-width: 0;
    }

    .dropzone-preview-name {
        font-size: 13px;
        font-weight: 700;
        color: #0F172A;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dropzone-preview-size {
        font-size: 11.5px;
        color: #94A3B8;
        margin-top: 2px;
    }

    .dropzone-remove-btn {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 9px;
        border: 1.5px solid rgba(220,38,38,.2);
        background: #FEF2F2;
        color: #DC2626;
        cursor: pointer;
        font-size: 13px;
        transition: background .15s ease, transform .12s ease;
    }

        .dropzone-remove-btn:hover {
            background: #DC2626;
            color: #fff;
        }

        .dropzone-remove-btn:active {
            transform: scale(.9);
        }

    .meal-file-hidden {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    .meal-btn-primary {
        width: 100%;
        padding: 14px 20px;
        background: linear-gradient(135deg, #3B82F6, #1D4ED8);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14.5px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(37,99,235,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: transform .15s ease, box-shadow .2s ease, opacity .2s ease;
    }

        .meal-btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(37,99,235,.4);
        }

        .meal-btn-primary:active:not(:disabled) {
            transform: translateY(0) scale(.98);
        }

        .meal-btn-primary:disabled {
            opacity: .55;
            cursor: not-allowed;
            box-shadow: none;
        }

    .meal-alert-error {
        background: rgba(239,68,68,0.08);
        color: #DC2626;
        border: 1px solid rgba(239,68,68,0.2);
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 20px;
        animation: fadeSlideUp .3s ease both;
    }

    .meal-inline-error {
        display: none;
        font-size: 12px;
        font-weight: 600;
        color: #DC2626;
        margin-top: 8px;
    }

    /* ── Analyzing overlay ── */
    .meal-scan-status {
        display: none;
        margin-top: 22px;
        padding: 18px;
        border-radius: 14px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
    }

    .meal-scan-status-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .meal-scan-ring {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 3px solid #DBEAFE;
        border-top-color: #2563EB;
        animation: spinSlow .8s linear infinite;
        flex-shrink: 0;
    }

    .meal-scan-status-text {
        font-size: 13px;
        font-weight: 700;
        color: #0F172A;
    }

    .meal-scan-status-sub {
        font-size: 11.5px;
        color: #64748B;
        margin-top: 1px;
    }

    .meal-scan-steps {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .meal-scan-step {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12.5px;
        color: #94A3B8;
        font-weight: 600;
        opacity: .45;
        transition: opacity .3s ease, color .3s ease;
    }

        .meal-scan-step .step-dot {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            border-radius: 50%;
            border: 2px solid #CBD5E1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            transition: all .3s ease;
        }

        .meal-scan-step.active {
            opacity: 1;
            color: #0F172A;
            animation: stepGlow 1.4s ease infinite;
        }

            .meal-scan-step.active .step-dot {
                border-color: #2563EB;
                background: #EFF6FF;
                color: #2563EB;
            }

        .meal-scan-step.done {
            opacity: 1;
            color: #16A34A;
            animation: none;
        }

            .meal-scan-step.done .step-dot {
                border-color: #16A34A;
                background: #16A34A;
                color: #fff;
                animation: checkPop .3s cubic-bezier(.34,1.56,.64,1);
            }

    @@media (max-width: 600px) {
        .meal-card {
            padding: 24px 20px;
            border-radius: 16px;
        }

            .meal-card h2 {
                font-size: 21px;
            }

        .meal-type-option span {
            font-size: 10px;
        }

        .dropzone {
            padding: 22px 14px;
        }
    }
</style>

<div class="nt-wrap">
    <div class="meal-card">
        <div class="meal-card-header">
            <div class="meal-card-icon"><i class="fas fa-camera"></i></div>
            <h2>Scan Your Meal</h2>
        </div>
        <p>Take or upload a photo of your meal and we'll estimate the nutrition for you.</p>

        @if (TempData["Error"] != null)
        {
            <div class="meal-alert-error">@TempData["Error"]</div>
        }

        @using (Html.BeginForm("Scan", "Meal", FormMethod.Post, new { enctype = "multipart/form-data", id = "scanForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="meal-form-group">
                <label>Meal Type</label>
                <div class="meal-type-seg" id="mealTypeSeg">
                    <div class="meal-type-seg-bg" id="mealTypeSegBg"></div>
                    <div class="meal-type-option active" data-value="Breakfast"><i class="fas fa-sun"></i><span>Breakfast</span></div>
                    <div class="meal-type-option" data-value="Lunch"><i class="fas fa-utensils"></i><span>Lunch</span></div>
                    <div class="meal-type-option" data-value="Dinner"><i class="fas fa-moon"></i><span>Dinner</span></div>
                    <div class="meal-type-option" data-value="Snack"><i class="fas fa-cookie-bite"></i><span>Snack</span></div>
                </div>
                <select name="mealType" id="mealType" required>
                    <option value="Breakfast">Breakfast</option>
                    <option value="Lunch">Lunch</option>
                    <option value="Dinner">Dinner</option>
                    <option value="Snack">Snack</option>
                </select>
            </div>

            <div class="meal-form-group">
                <label>Meal Photo</label>
                <div class="dropzone" id="dropzone">
                    <input type="file" name="mealPhoto" id="mealPhoto" class="meal-file-hidden" accept="image/*" required />

                    <div id="dropzoneEmpty">
                        <div class="dropzone-icon"><i class="fas fa-cloud-arrow-up"></i></div>
                        <div class="dropzone-title">Drag & drop your photo here</div>
                        <div class="dropzone-sub"><strong>Browse</strong> or drop a JPG/PNG</div>
                    </div>

                    <div class="dropzone-preview" id="dropzonePreview">
                        <img id="dropzonePreviewImg" src="" alt="Meal preview" />
                        <div class="dropzone-preview-info">
                            <div class="dropzone-preview-name" id="dropzonePreviewName"></div>
                            <div class="dropzone-preview-size" id="dropzonePreviewSize"></div>
                        </div>
                        <button type="button" class="dropzone-remove-btn" id="dropzoneRemoveBtn" title="Remove photo">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="meal-inline-error" id="fileError">Please choose an image file.</div>
            </div>

            <button type="submit" class="meal-btn-primary" id="scanSubmitBtn">
                <i class="fas fa-wand-magic-sparkles"></i> Scan Meal
            </button>

            <div class="meal-scan-status" id="scanStatus">
                <div class="meal-scan-status-head">
                    <div class="meal-scan-ring"></div>
                    <div>
                        <div class="meal-scan-status-text">Analysing your meal…</div>
                        <div class="meal-scan-status-sub">This can take a few seconds</div>
                    </div>
                </div>
                <div class="meal-scan-steps">
                    <div class="meal-scan-step" data-step="1"><span class="step-dot"><i class="fas fa-check"></i></span> Uploading photo</div>
                    <div class="meal-scan-step" data-step="2"><span class="step-dot"><i class="fas fa-check"></i></span> Detecting food items</div>
                    <div class="meal-scan-step" data-step="3"><span class="step-dot"><i class="fas fa-check"></i></span> Estimating nutrition</div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        // ── Segmented meal-type control ──
        var seg = document.getElementById('mealTypeSeg');
        var segBg = document.getElementById('mealTypeSegBg');
        var options = Array.prototype.slice.call(seg.querySelectorAll('.meal-type-option'));
        var select = document.getElementById('mealType');

        function moveBg(el) {
            var index = options.indexOf(el);
            segBg.style.transform = 'translateX(' + (index * 100) + '%)';
        }

        options.forEach(function (opt) {
            opt.addEventListener('click', function () {
                options.forEach(function (o) { o.classList.remove('active'); });
                opt.classList.add('active');
                select.value = opt.getAttribute('data-value');
                moveBg(opt);
            });
        });
        moveBg(options[0]);

        // ── Drag & drop photo zone ──
        var dropzone = document.getElementById('dropzone');
        var fileInput = document.getElementById('mealPhoto');
        var emptyState = document.getElementById('dropzoneEmpty');
        var previewState = document.getElementById('dropzonePreview');
        var previewImg = document.getElementById('dropzonePreviewImg');
        var previewName = document.getElementById('dropzonePreviewName');
        var previewSize = document.getElementById('dropzonePreviewSize');
        var removeBtn = document.getElementById('dropzoneRemoveBtn');
        var fileError = document.getElementById('fileError');

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        function showFile(file) {
            if (!file.type.match('image.*')) {
                fileError.style.display = 'block';
                fileInput.value = '';
                return;
            }
            fileError.style.display = 'none';

            var reader = new FileReader();
            reader.onload = function (e) {
                previewImg.src = e.target.result;
                previewName.textContent = file.name;
                previewSize.textContent = formatSize(file.size);
                emptyState.style.display = 'none';
                previewState.style.display = 'flex';
                dropzone.classList.add('has-file');
            };
            reader.readAsDataURL(file);
        }

        fileInput.addEventListener('change', function () {
            if (fileInput.files && fileInput.files[0]) showFile(fileInput.files[0]);
        });

        ['dragenter', 'dragover'].forEach(function (evt) {
            dropzone.addEventListener(evt, function (e) {
                e.preventDefault(); e.stopPropagation();
                dropzone.classList.add('dragover');
            });
        });
        ['dragleave', 'drop'].forEach(function (evt) {
            dropzone.addEventListener(evt, function (e) {
                e.preventDefault(); e.stopPropagation();
                dropzone.classList.remove('dragover');
            });
        });
        dropzone.addEventListener('drop', function (e) {
            var files = e.dataTransfer.files;
            if (files && files[0]) {
                fileInput.files = files;
                showFile(files[0]);
            }
        });

        removeBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            fileInput.value = '';
            previewImg.src = '';
            emptyState.style.display = 'block';
            previewState.style.display = 'none';
            dropzone.classList.remove('has-file');
        });

        // ── Submit: staged "analysing" animation ──
        var form = document.getElementById('scanForm');
        var submitBtn = document.getElementById('scanSubmitBtn');
        var scanStatus = document.getElementById('scanStatus');
        var steps = Array.prototype.slice.call(scanStatus.querySelectorAll('.meal-scan-step'));

        form.addEventListener('submit', function () {
            if (!fileInput.files || !fileInput.files[0]) return; // let native "required" validation handle it

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Scanning…';
            scanStatus.style.display = 'block';

            var delay = 0;
            steps.forEach(function (step, i) {
                setTimeout(function () {
                    steps.forEach(function (s) { s.classList.remove('active'); });
                    if (i > 0) steps[i - 1].classList.add('done');
                    step.classList.add('active');
                }, delay);
                delay += 700;
            });
            // Final step gets marked done just before the (real) page navigation/response arrives;
            // if the request is slow, it simply sits on the last "active" step, which still reads fine.
            setTimeout(function () {
                steps[steps.length - 1].classList.remove('active');
                steps[steps.length - 1].classList.add('done');
            }, delay);
        });
    })();
</script>