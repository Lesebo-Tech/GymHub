@model SwiftyS26.Models.StoreOrder
@using System.Linq

@{
    Layout = Session["LoggedInAdmin"] != null
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_StoreStaffLayout.cshtml";

    ViewBag.Title = "Confirm Order Ready";
    ViewBag.PageTitle = "CONFIRM ORDER READY";
    ViewBag.ActiveNav = "storeorders";

    var items = Model.Items != null
        ? Model.Items.ToList()
        : new System.Collections.Generic.List<SwiftyS26.Models.StoreOrderItem>();
}

<style>
    .cr-page {
        max-width: 1050px;
        margin: 0 auto;
    }

    .cr-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .cr-title {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .cr-title-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 11px;
        background: #f0fdf4;
        color: #16a34a;
        font-size: 19px;
    }

    .cr-header h2 {
        margin: 0;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 28px;
        letter-spacing: 1px;
        color: #0f172a;
    }

    .cr-header p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .cr-verified {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #f0fdf4;
        color: #15803d;
        font-size: 10.5px;
        font-weight: 850;
        text-transform: uppercase;
    }

    .cr-notice {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 18px;
        padding: 13px 15px;
        border: 1px solid #bbf7d0;
        border-radius: 11px;
        background: #f0fdf4;
        color: #15803d;
        font-size: 12.5px;
        font-weight: 650;
        line-height: 1.5;
    }

    .cr-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(280px, .7fr);
        gap: 18px;
        align-items: start;
    }

    .cr-card {
        overflow: hidden;
        margin-bottom: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
    }

    .cr-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 15px 18px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
    }

        .cr-card-head i {
            color: #2563eb;
        }

        .cr-card-head h3 {
            margin: 0;
            color: #0f172a;
            font-size: 15px;
        }

    .cr-card-body {
        padding: 18px;
    }

    .cr-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 17px 25px;
    }

    .cr-label {
        display: block;
        margin-bottom: 4px;
        color: #64748b;
        font-size: 10px;
        font-weight: 850;
        text-transform: uppercase;
    }

    .cr-value {
        color: #0f172a;
        font-size: 13px;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .cr-table-wrap {
        overflow-x: auto;
    }

    .cr-table {
        width: 100%;
        min-width: 560px;
        border-collapse: collapse;
        font-size: 12.5px;
    }

        .cr-table th {
            padding: 11px 12px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            color: #64748b;
            font-size: 10px;
            text-align: left;
            text-transform: uppercase;
        }

        .cr-table td {
            padding: 13px 12px;
            border-bottom: 1px solid #f1f5f9;
        }

        .cr-table tr:last-child td {
            border-bottom: 0;
        }

    .cr-total-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 0;
        border-bottom: 1px solid #edf2f7;
        font-size: 12.5px;
    }

        .cr-total-row:last-child {
            border-bottom: 0;
        }

        .cr-total-row span {
            color: #64748b;
        }

        .cr-total-row strong {
            color: #0f172a;
        }

        .cr-total-row.discount strong {
            color: #16a34a;
        }

        .cr-total-row.final {
            padding-top: 14px;
            font-size: 15px;
        }

    .cr-deadline {
        margin-top: 15px;
        padding: 12px;
        border: 1px solid #bfdbfe;
        border-radius: 9px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 11.5px;
        line-height: 1.5;
    }

    .cr-warning {
        margin-bottom: 15px;
        padding: 12px;
        border: 1px solid #fde68a;
        border-radius: 9px;
        background: #fffbeb;
        color: #b45309;
        font-size: 11.5px;
        line-height: 1.5;
    }

    .cr-actions {
        display: grid;
        gap: 10px;
    }

    .cr-button {
        width: 100%;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        padding: 11px 15px;
        border: 0;
        border-radius: 9px;
        background: #16a34a;
        color: #fff;
        font-size: 12px;
        font-weight: 850;
        cursor: pointer;
        text-decoration: none;
    }

        .cr-button.secondary {
            border: 1px solid #dbe3ef;
            background: #fff;
            color: #334155;
        }

    @@media (max-width: 850px) {
        .cr-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .cr-details {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cr-page">
    <div class="cr-header">
        <div class="cr-title">
            <div class="cr-title-icon">
                <i class="fas fa-circle-check"></i>
            </div>

            <div>
                <h2>Confirm Order Is Ready</h2>
                <p>@Model.ReferenceNumber</p>
            </div>
        </div>

        <span class="cr-verified">
            <i class="fas fa-shield-check"></i>
            QR Verified
        </span>
    </div>

    @if (TempData["Error"] != null)
    {
        <div style="margin-bottom:16px;padding:12px 15px;border:1px solid #fecaca;border-radius:10px;background:#fef2f2;color:#b91c1c;font-size:13px;font-weight:650;">
            <i class="fas fa-circle-exclamation"></i>
            @TempData["Error"]
        </div>
    }

    <div class="cr-notice">
        <i class="fas fa-circle-check"></i>
        <div>
            The internal QR code was verified successfully. Confirm that every
            item below has been prepared before marking the order ready.
        </div>
    </div>

    <div class="cr-grid">
        <main>
            <section class="cr-card">
                <div class="cr-card-head">
                    <i class="fas fa-user"></i>
                    <h3>Order Information</h3>
                </div>

                <div class="cr-card-body">
                    <div class="cr-details">
                        <div>
                            <span class="cr-label">Order Reference</span>
                            <div class="cr-value">@Model.ReferenceNumber</div>
                        </div>

                        <div>
                            <span class="cr-label">Current Status</span>
                            <div class="cr-value">@Model.Status</div>
                        </div>

                        <div>
                            <span class="cr-label">Member</span>
                            <div class="cr-value">
                                @(Model.Member != null
                                    ? Model.Member.FullName
                                    : "Unknown member")
                            </div>
                        </div>

                        <div>
                            <span class="cr-label">Member Number</span>
                            <div class="cr-value">
                                @(Model.Member != null
                                    ? Model.Member.MemberNumber
                                    : "—")
                            </div>
                        </div>

                        <div>
                            <span class="cr-label">Order Date</span>
                            <div class="cr-value">
                                @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        <div>
                            <span class="cr-label">Payment Date</span>
                            <div class="cr-value">
                                @(Model.PaidAt.HasValue
                                    ? Model.PaidAt.Value.ToString("dd MMM yyyy HH:mm")
                                    : "—")
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="cr-card">
                <div class="cr-card-head">
                    <i class="fas fa-boxes-packing"></i>
                    <h3>Preparation Checklist</h3>
                </div>

                @if (!items.Any())
                {
                    <div class="cr-card-body">
                        No items were found for this order.
                    </div>
                }
                else
                {
                    <div class="cr-table-wrap">
                        <table class="cr-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Stock Reserved</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    <tr>
                                        <td>
                                            <strong>
                                                @(item.Product != null
                                                    ? item.Product.Name
                                                    : "Unavailable product")
                                            </strong>
                                        </td>
                                        <td>@item.Quantity</td>
                                        <td>
                                            @if (Model.IsPickupStockReserved)
                                            {
                                                <span style="color:#16a34a;font-weight:750;">
                                                    <i class="fas fa-circle-check"></i>
                                                    Reserved
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="color:#dc2626;font-weight:750;">
                                                    <i class="fas fa-circle-xmark"></i>
                                                    Not reserved
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </main>

        <aside>
            <section class="cr-card">
                <div class="cr-card-head">
                    <i class="fas fa-receipt"></i>
                    <h3>Order Summary</h3>
                </div>

                <div class="cr-card-body">
                    <div class="cr-total-row">
                        <span>Subtotal</span>
                        <strong>R@Model.Subtotal.ToString("F2")</strong>
                    </div>

                    <div class="cr-total-row discount">
                        <span>Discount</span>
                        <strong>−R@Model.DiscountAmount.ToString("F2")</strong>
                    </div>

                    <div class="cr-total-row final">
                        <span>Amount Paid</span>
                        <strong>R@Model.FinalTotal.ToString("F2")</strong>
                    </div>

                    <div class="cr-deadline">
                        <i class="fas fa-calendar-days"></i>
                        A five-day collection period will begin when this order
                        is marked ready.
                    </div>
                </div>
            </section>

            <section class="cr-card">
                <div class="cr-card-head">
                    <i class="fas fa-clipboard-check"></i>
                    <h3>Final Confirmation</h3>
                </div>

                <div class="cr-card-body">
                    <div class="cr-warning">
                        <i class="fas fa-triangle-exclamation"></i>
                        Confirm that all products and quantities have been
                        physically prepared. The member will be notified
                        immediately.
                    </div>

                    <div class="cr-actions">
                        @using (Html.BeginForm(
                            "MarkReady",
                            "StoreAdmin",
                            FormMethod.Post,
                            new
                            {
                                onsubmit =
                                    "return confirm('Confirm that all items have been prepared and mark this order ready?');"
                            }))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="orderId"
                                   value="@Model.StoreOrderId" />

                            <button type="submit"
                                    class="cr-button">
                                <i class="fas fa-check"></i>
                                Mark Ready for Pickup
                            </button>
                        }

                        <a href="@Url.Action("ScanReadyOrder", "StoreAdmin")"
                           class="cr-button secondary">
                            <i class="fas fa-qrcode"></i>
                            Scan Again
                        </a>

                        <a href="@Url.Action("Orders", "StoreAdmin")"
                           class="cr-button secondary">
                            <i class="fas fa-arrow-left"></i>
                            Cancel
                        </a>
                    </div>
                </div>
            </section>
        </aside>
    </div>
</div>
