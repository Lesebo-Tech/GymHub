<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - GymHub Technician Portal</title>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        /* ============================================================
           CSS VARIABLES
        ============================================================ */
        :root {
            /* ── Brand blues ── */
            --blue: #2563eb;
            --blue-dark: #1d4ed8;
            --blue-bright: #3b82f6;
            --blue-light: #eff6ff;
            --blue-mid: #dbeafe;
            /* ── Semantic colours ── */
            --green: #16a34a;
            --green-light: #f0fdf4;
            --red: #dc2626;
            --red-light: #fef2f2;
            --gold: #d97706;
            --gold-light: #fffbeb;
            --orange: #ea580c;
            --orange-light: #fff7ed;
            --purple: #7c3aed;
            --purple-light: #f5f3ff;
            /* ── Text ── */
            --text-primary: #111111;
            --text-sub: #334155;
            --text-secondary: #555555;
            --text-muted: #aaaaaa;
            /* ── Surfaces ── */
            --bg: #f0f2f5;
            --bg2: #ffffff;
            --bg3: #f1f5f9;
            --sidebar-bg: #ffffff;
            --border: #e2e8f0;
            /* ── Misc ── */
            --avatar-bg: linear-gradient(135deg, #2dd4bf, #0d9488);
            --shadow: 0 8px 40px rgba(0,0,0,.10);
            --shadow-sm: 0 1px 3px rgba(0,0,0,.06);
            --shadow-md: 0 4px 16px rgba(0,0,0,.08);
            --shadow-lg: 0 10px 40px rgba(0,0,0,.10);
            /* ── Radius ── */
            --radius: 10px;
            --radius-sm: 10px;
            --radius-md: 12px;
            --radius-lg: 14px;
            /* ── Layout ── */
            --sidebar-w: 268px;
            --font: 'DM Sans', sans-serif;
            /* ── Legacy aliases ── */
            --accent: #2563eb;
            --accent-light: #eff6ff;
            --accent-hover: #1d4ed8;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: var(--font);
            cursor: pointer;
            border: none;
            background: none;
        }

        .layout {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* ============================================================
           SIDEBAR
        ============================================================ */
        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            background: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            height: 100vh;
            position: sticky;
            top: 0;
            overflow-y: auto;
            box-shadow: var(--shadow);
            z-index: 100;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 16px 16px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .logo-box {
            width: 40px;
            height: 40px;
            background: var(--blue);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
            color: #fff;
            letter-spacing: .5px;
            flex-shrink: 0;
        }

        .logo-text {
            font-weight: 800;
            font-size: 17px;
            letter-spacing: 1.5px;
            color: var(--text-primary);
        }

        .nav-section {
            padding: 14px 10px 6px;
        }

        .section-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--text-muted);
            padding: 0 8px;
            margin-bottom: 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            color: var(--text-secondary);
            font-size: 13.5px;
            font-weight: 500;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }

            .nav-item:hover {
                background: var(--blue-light);
                color: var(--blue);
            }

            .nav-item.active {
                background: var(--blue-light);
                color: var(--blue);
                font-weight: 600;
            }

            .nav-item svg {
                width: 17px;
                height: 17px;
                flex-shrink: 0;
                opacity: .65;
                transition: opacity .15s;
            }

            .nav-item:hover svg, .nav-item.active svg {
                opacity: 1;
            }

        .nav-divider {
            height: 1px;
            background: var(--border);
            margin: 4px 10px;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 10px;
            border-top: 1px solid var(--border);
            flex-shrink: 0;
        }

        .profile-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: background .15s;
        }

            .profile-card:hover {
                background: #f5f5f5;
            }

        .avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--avatar-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 12px;
            color: #fff;
            flex-shrink: 0;
        }

        .profile-info {
            flex: 1;
            min-width: 0;
        }

        .profile-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profile-role {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 1px;
        }

        .profile-menu-btn {
            color: var(--text-muted);
            font-size: 18px;
            font-weight: 700;
            padding: 2px 4px;
            border-radius: 6px;
            transition: background .15s;
        }

            .profile-menu-btn:hover {
                background: #eee;
            }

        .signout-form {
            display: inline;
        }

        /* ============================================================
           MAIN CONTENT
        ============================================================ */
        .main-content {
            flex: 1;
            padding: 32px 36px;
            min-width: 0;
            overflow-y: auto;
        }

        /* ============================================================
           ALERT BANNERS
        ============================================================ */
        .alert {
            padding: 12px 18px;
            border-radius: var(--radius-sm);
            font-size: 13.5px;
            font-weight: 500;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-success {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .alert-error {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        /* ============================================================
           SECTION HEADER
        ============================================================ */
        .section-header {
            margin-bottom: 28px;
        }

        .section-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-primary);
        }

        .section-sub {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* ============================================================
           DASH CARD
        ============================================================ */
        .dash-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            margin-bottom: 24px;
        }

        .card-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            background: var(--bg3);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .card-title {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-primary);
        }

        .card-action-btn {
            font-size: 13px;
            font-weight: 600;
            color: var(--blue);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: opacity .15s;
        }

            .card-action-btn:hover {
                opacity: .75;
            }

        /* ============================================================
           BUTTONS
        ============================================================ */
        .btn-primary-sm {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            background: var(--blue);
            color: #fff;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-primary-sm:hover {
                background: var(--blue-dark);
            }

        .btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
            background: #fff;
            border: 1px solid var(--border);
            transition: all .2s;
        }

            .btn-ghost:hover {
                background: var(--blue-light);
                color: var(--blue);
                border-color: rgba(37,99,235,.2);
            }

        /* ============================================================
           TABLE UTILITIES
        ============================================================ */
        .table-responsive {
            overflow-x: auto;
        }

        .action-links {
            display: flex;
            gap: 12px;
        }

        .link-success {
            color: var(--green);
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .link-info {
            color: var(--blue);
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .link-success:hover {
            text-decoration: underline;
        }

        .link-info:hover {
            text-decoration: underline;
        }

        .action-buttons {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .inline-form {
            display: inline;
        }

        .action-btn {
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-family: var(--font);
            transition: all .15s;
        }

            .action-btn.success {
                background: var(--green-light);
                color: var(--green);
            }

                .action-btn.success:hover {
                    background: var(--green);
                    color: #fff;
                }

            .action-btn.danger {
                background: var(--red-light);
                color: var(--red);
            }

                .action-btn.danger:hover {
                    background: var(--red);
                    color: #fff;
                }

        /* ============================================================
           TYPOGRAPHY UTILITIES
        ============================================================ */
        .member-name {
            font-weight: 600;
            color: var(--text-primary);
        }

        .text-muted {
            color: var(--text-muted);
        }

        .text-sub {
            color: var(--text-sub);
        }

        .notes-cell {
            max-width: 200px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ============================================================
           EMPTY STATE
        ============================================================ */
        .empty-state {
            text-align: center;
            padding: 48px 20px;
            color: var(--text-muted);
        }

            .empty-state i {
                font-size: 40px;
                margin-bottom: 12px;
                opacity: .4;
                display: block;
            }

            .empty-state p {
                font-size: 14px;
                margin-bottom: 12px;
            }

        .empty-state-btn {
            display: inline-block;
            padding: 9px 20px;
            background: var(--blue);
            color: #fff;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: background .15s;
        }

            .empty-state-btn:hover {
                background: var(--blue-dark);
            }

        /* ============================================================
           CARD UTILITY
        ============================================================ */
        .card {
            background: #fff;
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: 0 2px 16px rgba(0,0,0,.06);
        }

        /* ============================================================
           NOTIFICATION BELL
        ============================================================ */
        .notif-bell-wrap {
            position: fixed;
            top: 18px;
            right: 28px;
            z-index: 300;
        }

        .notif-bell-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #fff;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
            position: relative;
            color: var(--text-secondary);
            transition: background .15s, color .15s;
        }

            .notif-bell-btn:hover {
                background: var(--blue-light);
                color: var(--blue);
            }

            .notif-bell-btn svg {
                width: 18px;
                height: 18px;
            }

        .notif-badge {
            position: absolute;
            top: -3px;
            right: -3px;
            min-width: 17px;
            height: 17px;
            padding: 0 4px;
            border-radius: 999px;
            background: var(--red);
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            display: none;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

            .notif-badge.show {
                display: flex;
            }

        .notif-dropdown {
            display: none;
            position: absolute;
            top: 50px;
            right: 0;
            width: 340px;
            max-height: 440px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            flex-direction: column;
        }

            .notif-dropdown.open {
                display: flex;
            }

        .notif-dropdown-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            background: var(--bg3);
            flex-shrink: 0;
        }

        .notif-dropdown-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .notif-mark-all {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--blue);
            background: none;
            border: none;
            cursor: pointer;
        }

            .notif-mark-all:hover {
                text-decoration: underline;
            }

        .notif-list {
            overflow-y: auto;
            flex: 1;
        }

        .notif-item {
            display: block;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            transition: background .12s;
        }

            .notif-item:last-child {
                border-bottom: none;
            }

            .notif-item:hover {
                background: var(--bg3);
            }

            .notif-item.unread {
                background: var(--blue-light);
            }

                .notif-item.unread:hover {
                    background: var(--blue-mid);
                }

        .notif-item-top {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 3px;
        }

        .notif-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--blue);
            flex-shrink: 0;
            margin-top: 5px;
        }

        .notif-item-title {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-primary);
            flex: 1;
        }

        .notif-item-time {
            font-size: 10.5px;
            color: var(--text-muted);
            white-space: nowrap;
            flex-shrink: 0;
        }

        .notif-item-msg {
            font-size: 12px;
            color: var(--text-secondary);
            line-height: 1.4;
            padding-left: 15px;
        }

        .notif-empty {
            padding: 40px 20px;
            text-align: center;
            color: var(--text-muted);
            font-size: 12.5px;
        }

            .notif-empty i {
                font-size: 26px;
                opacity: .3;
                display: block;
                margin-bottom: 8px;
            }

        /* ============================================================
           RESPONSIVE — MOBILE OVERLAY SIDEBAR
        ============================================================ */
        .sidebar-toggle {
            display: none;
            position: fixed;
            top: 14px;
            left: 14px;
            z-index: 200;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--blue);
            color: #fff;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(37,99,235,.35);
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: fixed;
                transform: translateX(calc(-1 * var(--sidebar-w)));
                transition: transform .28s cubic-bezier(.4,0,.2,1);
                height: 100%;
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .sidebar-toggle {
                display: flex;
            }

            .main-content {
                padding: 20px 16px;
                padding-top: 64px;
            }

            .overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.3);
                z-index: 99;
            }

                .overlay.show {
                    display: block;
                }

            .notif-bell-wrap {
                top: 14px;
                right: 14px;
            }

            .notif-dropdown {
                width: calc(100vw - 28px);
                right: -10px;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />
    <link rel="apple-touch-icon" href="/Content/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GymHub" />
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function (err) {
                    console.warn('Service worker registration failed:', err);
                });
            });
        }
    </script>

</head>
<body>

    <div class="layout">

        <!-- ── MOBILE TOGGLE ── -->
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Open menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>
        <div class="overlay" id="overlay"></div>

        <!-- ── NOTIFICATION BELL ── -->
        <div class="notif-bell-wrap">
            <button type="button" class="notif-bell-btn" id="notifBellBtn" aria-label="Notifications">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                <span class="notif-badge" id="notifBadge">0</span>
            </button>
            <div class="notif-dropdown" id="notifDropdown">
                <div class="notif-dropdown-head">
                    <div class="notif-dropdown-title">Notifications</div>
                    <button type="button" class="notif-mark-all" id="notifMarkAllBtn">Mark all as read</button>
                </div>
                <div class="notif-list" id="notifList">
                    <div class="notif-empty">
                        <i class="fas fa-bell-slash"></i>
                        Loading…
                    </div>
                </div>
            </div>
        </div>

        <!-- ── SIDEBAR ── -->
        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <div class="logo-box">GH</div>
                <span class="logo-text">GYMHUB</span>
            </div>

            @{
                var action = ViewContext.RouteData.Values["action"].ToString();
            }

            <nav class="nav-section">
                <div class="section-label">Technician</div>

                <a href="@Url.Action("Dashboard", "Technician")"
                   class="nav-item @(action == "Dashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                    Dashboard
                </a>

                <a href="@Url.Action("ScanQr", "Technician")"
                   class="nav-item @(action == "ScanQr" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 7V5a2 2 0 0 1 2-2h2" />
                        <path d="M17 3h2a2 2 0 0 1 2 2v2" />
                        <path d="M21 17v2a2 2 0 0 1-2 2h-2" />
                        <path d="M7 21H5a2 2 0 0 1-2-2v-2" />
                        <rect x="7" y="7" width="4" height="4" />
                        <rect x="13" y="7" width="4" height="4" />
                        <rect x="7" y="13" width="4" height="4" />
                        <rect x="13" y="13" width="4" height="4" />
                    </svg>
                    Scan Equipment
                </a>

                <a href="@Url.Action("MyRepairs", "Technician")"
                   class="nav-item @(action == "MyRepairs" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                    My Repairs
                </a>

                <a href="@Url.Action("RepairHistory", "Technician")"
                   class="nav-item @(action == "RepairHistory" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    Repair History
                </a>

                <a href="@Url.Action("MyInspections", "Technician")"
                   class="nav-item @(action == "MyInspections" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 11l3 3L22 4" />
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                    </svg>
                    My Inspections
                </a>

                <a href="@Url.Action("MyMaintenance", "Technician")"
                   class="nav-item @(action == "MyMaintenance" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                    My Maintenance
                </a>

                <a href="@Url.Action("MyMaintenanceHistory", "Technician")"
                   class="nav-item @(action == "MyMaintenanceHistory" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    Maintenance History
                </a>
            </nav>

            <div class="nav-divider"></div>

            <nav class="nav-section">
                <div class="section-label">Account</div>

                <a href="@Url.Action("ChangePassword", "Technician")"
                   class="nav-item @(action == "ChangePassword" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    Change Password
                </a>
            </nav>

            <!-- Profile Footer -->
            <div class="sidebar-footer">
                @{
                    string technicianName = ViewBag.TechnicianName as string ?? "Technician";
                    string technicianRole = ViewBag.TechnicianRole as string ?? "Technician";
                    string initials = string.Concat(
                        technicianName.Split(' ')
                                   .Where(w => w.Length > 0)
                                   .Take(2)
                                   .Select(w => w[0].ToString().ToUpper()));
                }

                <div class="profile-card">
                    <div class="avatar">@initials</div>
                    <div class="profile-info">
                        <div class="profile-name">@technicianName</div>
                        <div class="profile-role">@technicianRole</div>
                    </div>
                    @using (Html.BeginForm("Logout", "Technician", FormMethod.Post, new { @class = "signout-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="profile-menu-btn" title="Sign Out">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                        </button>
                    }
                </div>
            </div>

        </aside>

        <!-- ── MAIN CONTENT ── -->
        <main class="main-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    @TempData["Error"]
                </div>
            }

            @RenderBody()

        </main>

    </div>

    <script>
        (function () {
            var sidebar = document.getElementById('sidebar');
            var toggle = document.getElementById('sidebarToggle');
            var overlay = document.getElementById('overlay');

            function openSidebar() { sidebar.classList.add('open'); overlay.classList.add('show'); }
            function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('show'); }

            if (toggle) toggle.addEventListener('click', openSidebar);
            if (overlay) overlay.addEventListener('click', closeSidebar);
        })();

        // ============================================================
        // NOTIFICATION BELL
        // Polls /Notification/GetRecent, renders unread badge + dropdown.
        // Same pattern is reused verbatim on the admin layout.
        // ============================================================
        (function () {
            var bellBtn = document.getElementById('notifBellBtn');
            var dropdown = document.getElementById('notifDropdown');
            var badge = document.getElementById('notifBadge');
            var list = document.getElementById('notifList');
            var markAllBtn = document.getElementById('notifMarkAllBtn');
            var pollTimer = null;

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str || '';
                return div.innerHTML;
            }

            function typeColor(type) {
                switch (type) {
                    case 'Success': return '#16a34a';
                    case 'Warning': return '#d97706';
                    case 'Alert': return '#dc2626';
                    default: return '#2563eb';
                }
            }

            function renderList(notifications) {
                if (!notifications || notifications.length === 0) {
                    list.innerHTML = '<div class="notif-empty"><i class="fas fa-bell-slash"></i>No notifications yet</div>';
                    return;
                }
                list.innerHTML = notifications.map(function (n) {
                    var unreadClass = n.IsRead ? '' : ' unread';
                    var dotColor = typeColor(n.Type);
                    return '' +
                        '<a class="notif-item' + unreadClass + '" data-id="' + n.NotificationId + '" data-link="' + escapeHtml(n.LinkUrl || '') + '">' +
                        '  <div class="notif-item-top">' +
                        '    <span class="notif-dot" style="background:' + dotColor + '"></span>' +
                        '    <span class="notif-item-title">' + escapeHtml(n.Title) + '</span>' +
                        '    <span class="notif-item-time">' + escapeHtml(n.timeAgo) + '</span>' +
                        '  </div>' +
                        '  <div class="notif-item-msg">' + escapeHtml(n.Message) + '</div>' +
                        '</a>';
                }).join('');

                Array.from(list.querySelectorAll('.notif-item')).forEach(function (el) {
                    el.addEventListener('click', function () {
                        var id = this.getAttribute('data-id');
                        var link = this.getAttribute('data-link');
                        markAsRead(id);
                        if (link) window.location.href = link;
                    });
                });
            }

            function refresh() {
                fetch('/Notification/GetRecent', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) return;
                        renderList(data.notifications);
                        if (data.unreadCount > 0) {
                            badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount;
                            badge.classList.add('show');
                        } else {
                            badge.classList.remove('show');
                        }
                    })
                    .catch(function () { /* silent — bell just won't update this cycle */ });
            }

            function markAsRead(id) {
                var formData = new FormData();
                formData.append('id', id);
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) formData.append('__RequestVerificationToken', token.value);
                fetch('/Notification/MarkAsRead', { method: 'POST', body: formData, credentials: 'same-origin' })
                    .then(function () { refresh(); })
                    .catch(function () { });
            }

            markAllBtn.addEventListener('click', function () {
                var formData = new FormData();
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) formData.append('__RequestVerificationToken', token.value);
                fetch('/Notification/MarkAllAsRead', { method: 'POST', body: formData, credentials: 'same-origin' })
                    .then(function () { refresh(); })
                    .catch(function () { });
            });

            bellBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('open');
                if (dropdown.classList.contains('open')) refresh();
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target) && e.target !== bellBtn) {
                    dropdown.classList.remove('open');
                }
            });

            refresh();
            pollTimer = setInterval(refresh, 30000); // poll every 30s
        })();
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
