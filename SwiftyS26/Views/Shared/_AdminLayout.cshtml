    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- ===== MAIN ===== -->
    <main class="admin-main">

        <div class="admin-topbar">
            <div style="display:flex; align-items:center; gap:14px;">
                <button type="button" class="sidebar-mobile-toggle" id="sidebarMobileToggle" aria-label="Open menu">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="topbar-title">@pageTitle</div>
            </div>
            <div class="topbar-right">
                <div class="topbar-date">
                    <i class="fas fa-calendar-alt"></i>
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                </div>

                <!-- ── NOTIFICATION BELL ── -->
                <div class="notif-bell-wrap">
                    <button type="button" class="notif-bell-btn" id="notifBellBtn" aria-label="Notifications">
                        <i class="fas fa-bell"></i>
                        <span class="notif-badge" id="notifBadge">0</span>
                    </button>
                    <div class="notif-dropdown" id="notifDropdown">
                        <div class="notif-dropdown-head">
                            <div class="notif-dropdown-title">Notifications</div>
                            <button type="button" class="notif-mark-all" id="notifMarkAllBtn">Mark all as read</button>
                        </div>
                        <div class="notif-list" id="notifList">
                            <div class="notif-empty">
                                <i class="fas fa-bell-slash"></i>
                                Loading…
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-page">
            @RenderBody()
        </div>

    </main>

    @RenderSection("Modals", required: false)

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script>
        // ============================================================
        // SHARED HELPERS (used by every /Admin page)
        // ============================================================
        function getToken() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function filterTable(inputId, tableId) {
            var q = document.getElementById(inputId).value.toLowerCase();
            document.querySelectorAll('#' + tableId + ' tbody tr').forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }

        function showAdminSuccessBanner(msg) {
            var existing = document.getElementById('admin-success-banner'); if (existing) existing.remove();
            var banner = document.createElement('div');
            banner.id = 'admin-success-banner';
            banner.style.cssText = [
                'position:fixed;top:20px;right:20px',
                'background:var(--white)',
                'border:1px solid #bbf7d0',
                'border-left:4px solid var(--green)',
                'border-radius:var(--radius-sm)',
                'padding:14px 20px',
                'color:#166534',
                'font-size:14px',
                'font-weight:600',
                'z-index:1000',
                'box-shadow:var(--shadow-md)',
                'max-width:380px',
                'animation:fadeUp 0.22s ease both'
            ].join(';');
            banner.innerHTML = msg;
            document.body.appendChild(banner);
            setTimeout(function () { if (banner.parentNode) banner.parentNode.removeChild(banner); }, 4500);
        }

        // ============================================================
        // SIDEBAR: collapse (desktop) + off-canvas (mobile)
        // ============================================================
        (function () {
            var sidebar = document.getElementById('adminSidebar');
            var collapseBtn = document.getElementById('sidebarCollapseBtn');
            var mobileToggle = document.getElementById('sidebarMobileToggle');
            var backdrop = document.getElementById('sidebarBackdrop');
            var STORAGE_KEY = 'gymhub_admin_sidebar_collapsed';

            // restore collapsed state
            if (localStorage.getItem(STORAGE_KEY) === '1') {
                sidebar.classList.add('collapsed');
                document.body.classList.add('sidebar-collapsed');
            }

            collapseBtn.addEventListener('click', function () {
                var collapsed = sidebar.classList.toggle('collapsed');
                document.body.classList.toggle('sidebar-collapsed', collapsed);
                localStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
                collapseBtn.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
            });

            function openMobile() {
                sidebar.classList.add('mobile-open');
                backdrop.classList.add('active');
            }

            function closeMobile() {
                sidebar.classList.remove('mobile-open');
                backdrop.classList.remove('active');
            }

            mobileToggle.addEventListener('click', openMobile);
            backdrop.addEventListener('click', closeMobile);
        })();

        // ============================================================
        // NOTIFICATION BELL
        // Polls /Notification/GetRecent, renders unread badge + dropdown.
        // Reuses the shared getToken() helper above. Same pattern as
        // the technician layout's bell, just positioned inline in the
        // topbar instead of fixed (admin already has a topbar).
        // ============================================================
        (function () {
            var bellBtn = document.getElementById('notifBellBtn');
            var dropdown = document.getElementById('notifDropdown');
            var badge = document.getElementById('notifBadge');
            var list = document.getElementById('notifList');
            var markAllBtn = document.getElementById('notifMarkAllBtn');

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str || '';
                return div.innerHTML;
            }

            function typeColor(type) {
                switch (type) {
                    case 'Success': return '#16a34a';
                    case 'Warning': return '#d97706';
                    case 'Alert': return '#dc2626';
                    default: return '#2563eb';
                }
            }

            function renderList(notifications) {
                if (!notifications || notifications.length === 0) {
                    list.innerHTML = '<div class="notif-empty"><i class="fas fa-bell-slash"></i>No notifications yet</div>';
                    return;
                }
                list.innerHTML = notifications.map(function (n) {
                    var unreadClass = n.IsRead ? '' : ' unread';
                    var dotColor = typeColor(n.Type);
                    return '' +
                        '<a class="notif-item' + unreadClass + '" data-id="' + n.NotificationId + '" data-link="' + escapeHtml(n.LinkUrl || '') + '">' +
                        '  <div class="notif-item-top">' +
                        '    <span class="notif-dot" style="background:' + dotColor + '"></span>' +
                        '    <span class="notif-item-title">' + escapeHtml(n.Title) + '</span>' +
                        '    <span class="notif-item-time">' + escapeHtml(n.timeAgo) + '</span>' +
                        '  </div>' +
                        '  <div class="notif-item-msg">' + escapeHtml(n.Message) + '</div>' +
                        '</a>';
                }).join('');

                Array.from(list.querySelectorAll('.notif-item')).forEach(function (el) {
                    el.addEventListener('click', function () {
                        var id = this.getAttribute('data-id');
                        var link = this.getAttribute('data-link');
                        markAsRead(id);
                        if (link) window.location.href = link;
                    });
                });
            }

            function refresh() {
                fetch('/Notification/GetRecent', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) return;
                        renderList(data.notifications);
                        if (data.unreadCount > 0) {
                            badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount;
                            badge.classList.add('show');
                        } else {
                            badge.classList.remove('show');
                        }
                    })
                    .catch(function () { /* silent — bell just won't update this cycle */ });
            }

            function markAsRead(id) {
                var formData = new FormData();
                formData.append('id', id);
                formData.append('__RequestVerificationToken', getToken());
                fetch('/Notification/MarkAsRead', { method: 'POST', body: formData, credentials: 'same-origin' })
                    .then(function () { refresh(); })
                    .catch(function () { });
            }

            markAllBtn.addEventListener('click', function () {
                var formData = new FormData();
                formData.append('__RequestVerificationToken', getToken());
                fetch('/Notification/MarkAllAsRead', { method: 'POST', body: formData, credentials: 'same-origin' })
                    .then(function () { refresh(); })
                    .catch(function () { });
            });

            bellBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('open');
                if (dropdown.classList.contains('open')) refresh();
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target) && e.target !== bellBtn && !bellBtn.contains(e.target)) {
                    dropdown.classList.remove('open');
                }
            });

            refresh();
            setInterval(refresh, 30000); // poll every 30s
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
