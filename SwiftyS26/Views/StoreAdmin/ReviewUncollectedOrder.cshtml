            color: #64748b;
            cursor: not-allowed;
        }

    .ur-footer-actions {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        margin-top: 3px;
    }

    @@media (max-width: 1150px) {
        .ur-action-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ur-action-card:last-child {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 900px) {
        .ur-summary-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .ur-details {
            grid-template-columns: 1fr;
        }

        .ur-action-grid {
            grid-template-columns: 1fr;
        }

        .ur-action-card:last-child {
