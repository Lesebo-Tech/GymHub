@model List<SwiftyS26.Models.MemberTrainer>
@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewBag.Title = "My Members";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        /* Stats Row */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

        .stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

            .stat-icon.blue {
                background: var(--blue-light);
                color: var(--blue);
            }

            .stat-icon.green {
                background: var(--green-light);
                color: var(--green);
            }

            .stat-icon.orange {
                background: var(--orange-light);
                color: var(--orange);
            }

        .stat-info {
            flex: 1;
        }

        .stat-number {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 32px;
            letter-spacing: 1px;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* Toolbar */
        .toolbar {
            margin-bottom: 24px;
        }

        .search-wrap {
            position: relative;
            max-width: 320px;
        }

        .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 14px;
        }

        .search-input {
            width: 100%;
            padding: 12px 16px 12px 42px;
            background: var(--bg3);
            border: 1.5px solid var(--border);
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            color: var(--text-primary);
            outline: none;
            transition: all 0.2s;
        }

            .search-input:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
                background: var(--bg2);
            }

        /* Members Grid */
        .members-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 20px;
        }

        /* Member Card */
        .member-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: all 0.2s;
        }

            .member-card:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
                border-color: var(--blue-light);
            }

        .card-top {
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            border-bottom: 1px solid var(--border);
            background: var(--bg3);
        }

        .member-avatar {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--blue), var(--blue-bright));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .member-info {
            flex: 1;
        }

        .member-name {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .plan-badge {
            display: inline-block;
            background: var(--gold-light);
            color: var(--gold);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        /* Card Body */
        .card-body {
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .detail-row {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 13px;
        }

        .detail-label {
            width: 70px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .detail-value {
            color: var(--text-primary);
            font-weight: 500;
        }

        /* Card Footer */
        .card-footer {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            background: var(--bg3);
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: var(--blue-light);
            color: var(--blue);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-action:hover {
                background: var(--blue);
                color: #fff;
                transform: translateY(-1px);
            }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
        }

            .empty-state i {
                font-size: 48px;
                margin-bottom: 16px;
                opacity: 0.4;
            }

            .empty-state h3 {
                font-size: 18px;
                margin-bottom: 8px;
            }

            .empty-state p {
                color: var(--text-muted);
                font-size: 13px;
            }

        /* Alert */
        .alert-success {
            background: var(--green-light);
            border: 1px solid rgba(34, 197, 94, 0.2);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--green);
            font-size: 13px;
            font-weight: 600;
        }

        /* Responsive */
        @@media (max-width: 900px) {
            .stats-row {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .members-grid {
                grid-template-columns: 1fr;
            }

            .toolbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .search-wrap {
                max-width: 100%;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="section-header">
    <div class="section-title">My Members</div>
    <div class="section-sub">@(Model?.Count ?? 0) member(s) assigned to you</div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

<!-- Stats -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fas fa-users"></i></div>
        <div class="stat-info">
            <div class="stat-number">@(Model?.Count ?? 0)</div>
            <div class="stat-label">Total Members</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="fas fa-crown"></i></div>
        <div class="stat-info">
            <div class="stat-number">@(Model?.Count(mt => mt.Member?.Plan?.ToLower() == "premium") ?? 0)</div>
            <div class="stat-label">Premium Members</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fas fa-chart-line"></i></div>
        <div class="stat-info">
            <div class="stat-number">@(Model?.Count(mt => mt.Member?.Plan?.ToLower() != "premium") ?? 0)</div>
            <div class="stat-label">Standard Members</div>
        </div>
    </div>
</div>

<!-- Search -->
<div class="toolbar">
    <div class="search-wrap">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="memberSearch" class="search-input" placeholder="Search by name or plan..." onkeyup="filterMembers()" />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="members-grid" id="membersGrid">
        @foreach (var mt in Model)
        {
            var member = mt.Member;
            if (member == null) { continue; }

            string fullName = $"{member.FirstName} {member.LastName}".Trim();
            string initials = string.Concat(fullName.Split(' ')
                .Where(w => w.Length > 0)
                .Take(2)
                .Select(w => w[0].ToString().ToUpper()));

            <div class="member-card" data-name="@fullName.ToLower()" data-plan="@member.Plan?.ToLower()">
                <div class="card-top">
                    <div class="member-avatar">@initials</div>
                    <div class="member-info">
                        <div class="member-name">@fullName</div>
                        <span class="plan-badge"><i class="fas fa-crown"></i> @member.Plan</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="detail-row">
                        <span class="detail-label"><i class="fas fa-phone"></i> Phone</span>
                        <span class="detail-value">@(member.Phone ?? "—")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label"><i class="fas fa-envelope"></i> Email</span>
                        <span class="detail-value">@(member.Email ?? "—")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label"><i class="fas fa-calendar"></i> Assigned</span>
                        <span class="detail-value">@mt.AssignedDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("MemberProgress", "Trainer", new { memberId = mt.MemberId })" class="btn-action">
                        <i class="fas fa-chart-line"></i> Log Progress
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-users-slash"></i>
        <h3>No Members Assigned</h3>
        <p>Members assigned to you will appear here.</p>
    </div>
}

@section Scripts {
    <script>
        function filterMembers() {
            var query = document.getElementById('memberSearch').value.toLowerCase();
            var cards = document.querySelectorAll('.member-card');

            cards.forEach(function (card) {
                var name = card.getAttribute('data-name') || '';
                var plan = card.getAttribute('data-plan') || '';
                var matches = name.includes(query) || plan.includes(query);
                card.style.display = matches ? '' : 'none';
            });
        }
    </script>
}