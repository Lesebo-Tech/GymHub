@model List<SwiftyS26.Models.WeeklyProgressLog>
@using SwiftyS26.Models
@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewBag.Title = "Member Weekly Progress";

    var members = ViewBag.Members as SelectList;
    int? selectedMemberId = ViewBag.SelectedMemberId as int?;
    var selectedMember = ViewBag.SelectedMember as MemberForm;
    var fitnessProfile = ViewBag.FitnessProfile as FitnessProfile;
    var logs = Model ?? new List<WeeklyProgressLog>();

    var firstLog = logs.FirstOrDefault();
    var lastLog = logs.LastOrDefault();
    decimal weightChange = (firstLog != null && lastLog != null) ? lastLog.WeightKg - firstLog.WeightKg : 0m;
    int totalWorkouts = logs.Sum(l => l.WorkoutsThisWeek);
    string changeSign = weightChange > 0 ? "+" : "";
    string changeClass = weightChange < 0 ? "text-success" : weightChange > 0 ? "text-danger" : "text-muted";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        /* ── Filter Bar ── */
        .filter-bar {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 16px 24px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

            .filter-bar label {
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-muted);
            }

        .member-select {
            min-width: 240px;
            padding: 10px 14px;
            background: var(--bg3);
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            color: var(--text-primary);
            cursor: pointer;
            outline: none;
        }

            .member-select:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(59,130,246,.1);
            }

        /* ── Member Banner ── */
        .member-banner {
            background: linear-gradient(135deg, var(--blue), var(--blue-bright));
            border-radius: var(--radius-lg);
            padding: 24px 28px;
            margin-bottom: 24px;
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
            align-items: center;
            color: #fff;
        }

        .banner-info {
            flex: 1;
        }

        .banner-name {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .banner-id {
            font-size: 12px;
            opacity: .8;
        }

        .banner-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
        }

        .banner-stat-value {
            font-size: 18px;
            font-weight: 700;
        }

        .banner-stat-label {
            font-size: 11px;
            opacity: .8;
            margin-top: 4px;
        }

        .banner-divider {
            width: 1px;
            height: 40px;
            background: rgba(255,255,255,.3);
        }

        /* ── Stats Row ── */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all .2s;
        }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

            .stat-icon.blue {
                background: var(--blue-light);
                color: var(--blue);
            }

            .stat-icon.green {
                background: var(--green-light);
                color: var(--green);
            }

            .stat-icon.red {
                background: var(--red-light);
                color: var(--red);
            }

            .stat-icon.orange {
                background: var(--orange-light);
                color: var(--orange);
            }

        .stat-number {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 32px;
            letter-spacing: 1px;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .text-success {
            color: var(--green);
        }

        .text-danger {
            color: var(--red);
        }

        .text-muted {
            color: var(--text-muted);
        }

        /* ── Table Card ── */
        .table-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .table-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            background: var(--bg3);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .table-title {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .table-count {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ── Week Table ── */
        .week-table {
            width: 100%;
            border-collapse: collapse;
        }

            .week-table th {
                padding: 12px 16px;
                text-align: left;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-muted);
                background: var(--bg3);
                border-bottom: 1px solid var(--border);
                white-space: nowrap;
            }

            .week-table td {
                padding: 14px 16px;
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
            }

            .week-table tr:last-child td {
                border-bottom: none;
            }

            .week-table tr:hover td {
                background: var(--blue-light);
            }

            .week-table .row-good td {
                background: rgba(34,197,94,.05);
            }

            .week-table .row-bad td {
                background: rgba(239,68,68,.05);
            }

        /* ── Pills ── */
        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        .pill-blue {
            background: var(--blue-light);
            color: var(--blue);
        }

        .pill-muted {
            background: var(--bg3);
            color: var(--text-muted);
            border: 1px solid var(--border);
        }

        /* ── Workout Dots ── */
        .workout-dots {
            display: flex;
            gap: 6px;
        }

        .workout-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--blue);
        }

            .workout-dot.empty {
                background: var(--border);
            }

        /* ── Notes ── */
        .notes-text {
            color: var(--text-muted);
            font-size: 12px;
            font-style: italic;
            max-width: 220px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }

        /* ── Empty State ── */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
        }

            .empty-state i {
                font-size: 48px;
                margin-bottom: 16px;
                opacity: .4;
                display: block;
            }

            .empty-state h3 {
                font-size: 18px;
                margin-bottom: 8px;
            }

            .empty-state p {
                color: var(--text-muted);
                font-size: 13px;
            }

        /* ── Responsive ── */
        @@media (max-width: 1000px) {
            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .stats-row {
                grid-template-columns: 1fr;
            }

            .member-banner {
                flex-direction: column;
                text-align: center;
            }

            .banner-stats {
                justify-content: center;
            }

            .banner-divider {
                display: none;
            }

            .week-table th,
            .week-table td {
                padding: 10px 12px;
                font-size: 12px;
            }

            .table-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}

<!-- ── Page Header ── -->
<div class="section-header">
    <div class="section-title">Weekly Progress</div>
    <div class="section-sub">View member-submitted weekly fitness logs</div>
</div>

<!-- ── Member Filter ── -->
<div class="filter-bar">
    <label><i class="fas fa-user"></i> Select Member</label>
    <select id="memberSelect" class="member-select" onchange="filterMember(this.value)">
        <option value="">— Select a Member —</option>
        @if (members != null)
        {
            foreach (SelectListItem item in members)
            {
                <option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>
            }
        }
    </select>
</div>

@if (selectedMember != null)
{
    <!-- ── Member Banner ── -->
    <div class="member-banner">
        <div class="banner-info">
            <div class="banner-name">@selectedMember.FullName</div>
            <div class="banner-id"><i class="fas fa-id-card"></i> @selectedMember.MemberNumber</div>
        </div>

        @if (fitnessProfile != null)
        {
            <div class="banner-stats">
                <div class="banner-stat">
                    <div class="banner-stat-value">@fitnessProfile.GoalType</div>
                    <div class="banner-stat-label"><i class="fas fa-bullseye"></i> Goal</div>
                </div>
                <div class="banner-divider"></div>
                <div class="banner-stat">
                    <div class="banner-stat-value">@fitnessProfile.WeightKg kg</div>
                    <div class="banner-stat-label"><i class="fas fa-weight-scale"></i> Start Weight</div>
                </div>
                <div class="banner-divider"></div>
                <div class="banner-stat">
                    <div class="banner-stat-value">@fitnessProfile.TargetWeightKg kg</div>
                    <div class="banner-stat-label"><i class="fas fa-bullseye"></i> Target</div>
                </div>
                <div class="banner-divider"></div>
                <div class="banner-stat">
                    <div class="banner-stat-value">@fitnessProfile.BMI.ToString("F1")</div>
                    <div class="banner-stat-label"><i class="fas fa-chart-line"></i> BMI (@fitnessProfile.BMICategory)</div>
                </div>
                <div class="banner-divider"></div>
                <div class="banner-stat">
                    <div class="banner-stat-value">@fitnessProfile.ProjectedWeeks wks</div>
                    <div class="banner-stat-label"><i class="fas fa-calendar"></i> Timeline</div>
                </div>
            </div>
        }
        else
        {
            <div class="banner-stat">
                <i class="fas fa-info-circle"></i> No fitness profile set up yet
            </div>
        }
    </div>

    if (logs.Any())
    {
        <!-- ── Summary Stat Cards ── -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="fas fa-calendar-week"></i></div>
                <div>
                    <div class="stat-number">@logs.Count</div>
                    <div class="stat-label">Weeks Logged</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="fas fa-dumbbell"></i></div>
                <div>
                    <div class="stat-number">@totalWorkouts</div>
                    <div class="stat-label">Total Workouts</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon @(weightChange < 0 ? "green" : "red")"><i class="fas fa-chart-line"></i></div>
                <div>
                    <div class="stat-number @changeClass">@changeSign@weightChange.ToString("F1") kg</div>
                    <div class="stat-label">Weight Change</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange"><i class="fas fa-weight-scale"></i></div>
                <div>
                    <div class="stat-number">@(lastLog != null ? lastLog.WeightKg.ToString("F1") : "—")</div>
                    <div class="stat-label">Latest Weight</div>
                </div>
            </div>
        </div>

        <!-- ── Week-by-Week Table ── -->
        <div class="table-card">
            <div class="table-header">
                <div class="table-title">
                    <i class="fas fa-list-alt"></i> Week-by-Week Log — @selectedMember.FullName
                </div>
                <div class="table-count">@logs.Count week@(logs.Count == 1 ? "" : "s") logged</div>
            </div>

            <div style="overflow-x:auto;">
                <table class="week-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-calendar-week"></i> Week</th>
                            <th><i class="fas fa-calendar"></i> Date Logged</th>
                            <th><i class="fas fa-weight-scale"></i> Weight (kg)</th>
                            <th><i class="fas fa-percent"></i> Body Fat %</th>
                            <th><i class="fas fa-dumbbell"></i> Workouts</th>
                            <th><i class="fas fa-chart-line"></i> Week Change</th>
                            <th><i class="fas fa-note-sticky"></i> Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < logs.Count; i++)
                        {
                            var log = logs[i];
                            decimal? delta = i > 0 ? log.WeightKg - logs[i - 1].WeightKg : (decimal?)null;
                            string rowClass = delta.HasValue ? (delta.Value < 0 ? "row-good" : delta.Value > 0.3m ? "row-bad" : "") : "";
                            string deltaClass = delta.HasValue ? (delta.Value < 0 ? "text-success" : delta.Value > 0 ? "text-danger" : "text-muted") : "";
                            string deltaSign = delta.HasValue && delta.Value > 0 ? "+" : "";

                            <tr class="@rowClass">
                                <td><span class="pill pill-blue"><i class="fas fa-calendar-week"></i> Week @log.WeekNumber</span></td>
                                <td class="text-muted">@log.LoggedDate.ToString("dd MMM yyyy")</td>
                                <td style="font-weight:700;">@log.WeightKg.ToString("F1") kg</td>
                                <td>@(log.BodyFatPercent.HasValue ? $"{log.BodyFatPercent.Value:F1}%" : "—")</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:12px;">
                                        <div class="workout-dots">
                                            @for (int d = 0; d < 7; d++)
                                            {
                                                <div class="workout-dot @(d < log.WorkoutsThisWeek ? "" : "empty")"></div>
                                            }
                                        </div>
                                        <span class="text-muted">@log.WorkoutsThisWeek/7</span>
                                    </div>
                                </td>
                                <td>
                                    @if (delta.HasValue)
                                    {
                                        <span class="@deltaClass">@deltaSign@delta.Value.ToString("F1") kg</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-muted"><i class="fas fa-flag-checkered"></i> Baseline</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.Notes))
                                    {
                                        <span class="notes-text" title="@log.Notes">@log.Notes</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-calendar-alt"></i>
            <h3>No weekly logs yet</h3>
            <p>@selectedMember.FirstName hasn't submitted any weekly progress entries yet.</p>
        </div>
    }
}
else if (selectedMemberId.HasValue)
{
    <div class="empty-state">
        <i class="fas fa-exclamation-triangle"></i>
        <h3>Member not found</h3>
        <p>This member is not assigned to you.</p>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-user-plus"></i>
        <h3>Select a member</h3>
        <p>Choose one of your assigned members from the dropdown above to view their weekly progress log.</p>
    </div>
}

@section Scripts {
    <script>
        function filterMember(memberId) {
            var baseUrl = '@Url.Action("MemberWeeklyProgress", "Trainer")';
            window.location.href = memberId ? (baseUrl + '?memberId=' + memberId) : baseUrl;
        }
    </script>
}
