@model List<SwiftyS26.Models.WorkoutProgram>
@{
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    ViewBag.Title = "Workout Programs";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        /* Stats Row */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

        .stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

            .stat-icon.blue {
                background: var(--blue-light);
                color: var(--blue);
            }

            .stat-icon.green {
                background: var(--green-light);
                color: var(--green);
            }

            .stat-icon.orange {
                background: var(--orange-light);
                color: var(--orange);
            }

        .stat-info {
            flex: 1;
        }

        .stat-number {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 32px;
            letter-spacing: 1px;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* Programs Grid */
        .programs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 24px;
        }

        /* Program Card */
        .program-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
        }

            .program-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--shadow-md);
                border-color: var(--blue-light);
            }

        .card-header {
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
            background: var(--bg3);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

        .program-name {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 6px;
        }

        .member-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            background: var(--blue-light);
            color: var(--blue);
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .edit-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--blue);
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

            .edit-link:hover {
                gap: 10px;
            }

        /* Card Body */
        .card-body {
            padding: 16px 20px;
            flex: 1;
        }

        .program-description {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 16px;
        }

        .program-dates {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .exercise-stats {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-size: 12px;
        }

        .exercise-label {
            color: var(--text-muted);
        }

        .exercise-count {
            font-weight: 700;
            color: var(--blue);
        }

        .progress-bar {
            height: 5px;
            background: var(--border);
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(135deg, var(--blue), var(--blue-bright));
            border-radius: 4px;
            transition: width 0.3s;
        }

        /* Exercise Tags */
        .exercise-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
        }

        .tag {
            padding: 5px 12px;
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 20px;
            font-size: 11px;
            color: var(--text-secondary);
        }

        .tag-primary {
            background: var(--blue-light);
            color: var(--blue);
            border-color: transparent;
        }

        .tag-more {
            background: var(--bg3);
            color: var(--text-muted);
        }

        /* Card Footer */
        .card-footer {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            background: var(--bg3);
            display: flex;
            gap: 12px;
        }

        .btn-primary-sm {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px;
            background: linear-gradient(135deg, var(--blue), var(--blue-bright));
            color: #fff;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-primary-sm:hover {
                transform: translateY(-1px);
                box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
            }

        .btn-secondary-sm {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px;
            background: transparent;
            border: 1.5px solid var(--border);
            color: var(--text-muted);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-secondary-sm:hover {
                background: var(--bg2);
                border-color: var(--blue);
                color: var(--blue);
            }

        /* Alert */
        .alert-success {
            background: var(--green-light);
            border: 1px solid rgba(34, 197, 94, 0.2);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--green);
            font-size: 13px;
            font-weight: 600;
        }

        .alert-danger {
            background: var(--red-light);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--red);
            font-size: 13px;
            font-weight: 600;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
        }

            .empty-state i {
                font-size: 48px;
                margin-bottom: 16px;
                opacity: 0.4;
            }

            .empty-state h3 {
                font-size: 18px;
                margin-bottom: 8px;
            }

            .empty-state p {
                color: var(--text-muted);
                font-size: 13px;
                margin-bottom: 20px;
            }

        /* Responsive */
        @@media (max-width: 900px) {
            .stats-row {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .programs-grid {
                grid-template-columns: 1fr;
            }

            .card-footer {
                flex-direction: column;
            }
        }
    </style>
}

<!-- Page Header -->
<div class="section-header">
    <div class="section-title">Workout Programs</div>
    <div class="section-sub">Manage and assign training programs to your members</div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

@{
    int totalPrograms = Model?.Count ?? 0;
    int totalExercises = Model?.Sum(w => w.ProgramExercises?.Count ?? 0) ?? 0;
    int assignedCount = Model?.Count(w => w.MemberForm != null) ?? 0;
}

<!-- Stats -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fas fa-dumbbell"></i></div>
        <div class="stat-info">
            <div class="stat-number">@totalPrograms</div>
            <div class="stat-label">Total Programs</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="fas fa-list-check"></i></div>
        <div class="stat-info">
            <div class="stat-number">@totalExercises</div>
            <div class="stat-label">Total Exercises</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fas fa-users"></i></div>
        <div class="stat-info">
            <div class="stat-number">@assignedCount</div>
            <div class="stat-label">Assigned to Members</div>
        </div>
    </div>
</div>

<!-- Action Button -->
<div style="margin-bottom: 24px; display: flex; justify-content: flex-end;">
    <a href="@Url.Action("CreateWorkoutProgram", "Trainer")" class="btn-primary-sm" style="width: auto; padding: 10px 24px;">
        <i class="fas fa-plus"></i> New Program
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="programs-grid">
        @foreach (var wp in Model)
        {
            int exCount = wp.ProgramExercises?.Count ?? 0;
            int barWidth = Math.Min(exCount * 10, 100);
            string memberName = wp.MemberForm?.FullName ?? "Unassigned";

            <div class="program-card">
                <div class="card-header">
                    <div>
                        <div class="program-name">@wp.ProgramName</div>
                        <div class="member-badge">
                            <i class="fas fa-user"></i> @memberName
                        </div>
                    </div>
                    <a href="@Url.Action("AddExercises", "Trainer", new { programId = wp.WorkoutProgramId })" class="edit-link">
                        Edit <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body">
                    <div class="program-description">
                        @(string.IsNullOrWhiteSpace(wp.Description) ? "No description provided." : wp.Description)
                    </div>
                    <div class="program-dates">
                        <i class="fas fa-calendar-alt"></i>
                        @wp.StartDate.ToString("dd MMM yyyy")
                        @if (wp.EndDate.HasValue)
                        {
                            <span>— @wp.EndDate.Value.ToString("dd MMM yyyy")</span>
                        }
                        else
                        {
                            <span>— Ongoing</span>
                        }
                    </div>
                    <div class="exercise-stats">
                        <span class="exercise-label"><i class="fas fa-list"></i> Exercises</span>
                        <span class="exercise-count">@exCount</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @barWidth%"></div>
                    </div>
                    @if (wp.ProgramExercises != null && wp.ProgramExercises.Any())
                    {
                        <div class="exercise-tags">
                            @foreach (var ex in wp.ProgramExercises.Take(4))
                            {
                                <span class="tag tag-primary"><i class="fas fa-check-circle"></i> @ex.ExerciseName</span>
                            }
                            @if (wp.ProgramExercises.Count > 4)
                            {
                                <span class="tag tag-more">+@(wp.ProgramExercises.Count - 4) more</span>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("AddExercises", "Trainer", new { programId = wp.WorkoutProgramId })" class="btn-primary-sm">
                        <i class="fas fa-plus"></i> Add Exercises
                    </a>
                    <a href="@Url.Action("WorkoutPrograms", "Trainer")" class="btn-secondary-sm">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-dumbbell"></i>
        <h3>No Programs Yet</h3>
        <p>Create your first workout program and assign it to a member.</p>
        <a href="@Url.Action("CreateWorkoutProgram", "Trainer")" class="btn-primary-sm">
            <i class="fas fa-plus"></i> Create Program
        </a>
    </div>
}

@section Scripts {
    <script>// Auto-hide alerts after 5 seconds
        setTimeout(function() {
            document.querySelectorAll('.alert-success, .alert-danger').forEach(function(alert) {
                alert.style.transition = 'opacity 0.5s';
                alert.style.opacity = '0';
                setTimeout(function() { alert.style.display = 'none'; }, 500);
            });
        }, 5000);</script>
}