    <div id="vendorModal" class="modal-overlay">
        <div class="modal-box">
            <div class="modal-title"><i class="fas fa-truck" style="color:var(--orange);font-size:20px;"></i> Assign Vendor</div>
            <p style="color:var(--muted);font-size:13px;margin-bottom:16px;"><span id="vendorEquipmentName"></span></p>

            @using (Html.BeginForm("AssignVendor", "Repair", FormMethod.Post, new { id = "vendorForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="repairId" id="vendor_RepairId" />

                <div class="form-group">
                    <label>Vendor <span style="color:var(--red)">*</span></label>
                    <select name="vendorId" class="form-control" required>
                        <option value="">Select a vendor</option>
                        @foreach (var v in vendors)
                        {
                            <option value="@v.VendorId">@v.CompanyName — @v.ServiceType</option>
                        }
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Priority</label>
                        <select name="priority" class="form-control">
                            <option value="Low">Low</option>
                            <option value="Medium" selected>Medium</option>
                            <option value="High">High</option>
                            <option value="Urgent">Urgent</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Due Date</label>
                        <input name="dueDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Notes</label>
                    <input name="assignmentNotes" class="form-control" placeholder="Optional" />
                </div>

                <div class="modal-actions">
                    <button type="submit" class="modal-btn save" style="background:var(--orange);"><i class="fas fa-check"></i> Assign Vendor</button>
                    <button type="button" class="modal-btn cancel" onclick="closeVendorModal()">Cancel</button>
                </div>
            }
        </div>
    </div>
}
@section Scripts{

    <script>
        function openAddModal() { document.getElementById('addModal').style.display = 'flex'; }
        function closeAddModal() { document.getElementById('addModal').style.display = 'none'; }

        function viewQr(name, code, dataUrl) {
            document.getElementById('qrModalTitle').textContent = name;
            document.getElementById('qrModalCode').textContent = code;
            document.getElementById('qrModalImage').src = dataUrl;
            document.getElementById('qrModal').style.display = 'flex';
        }
        function closeQrModal() { document.getElementById('qrModal').style.display = 'none'; }

        function filterTable() {
            var q = document.getElementById('equipmentSearch').value.toLowerCase();
            document.querySelectorAll('#equipmentTable tbody tr').forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }

        function openEditModal(id, name, category, brand, model, serial, gymArea, purchaseDate, purchaseCost, vendorName, vendorContact, warrantyExpiry, inspectionInterval, maintenanceInterval, notes, status, imagePath) {
            document.getElementById('edit_EquipmentId').value = id;
            document.getElementById('edit_Name').value = name;
            document.getElementById('edit_Category').value = category;
            document.getElementById('edit_Brand').value = brand;
            document.getElementById('edit_Model').value = model;
            document.getElementById('edit_SerialNumber').value = serial;
            document.getElementById('edit_GymArea').value = gymArea;
            document.getElementById('edit_PurchaseDate').value = purchaseDate === 'null' ? '' : purchaseDate;
            document.getElementById('edit_PurchaseCost').value = purchaseCost;
            document.getElementById('edit_VendorName').value = vendorName;
            document.getElementById('edit_VendorContact').value = vendorContact;
            document.getElementById('edit_WarrantyExpiryDate').value = warrantyExpiry === 'null' ? '' : warrantyExpiry;
            document.getElementById('edit_InspectionIntervalDays').value = inspectionInterval;
            document.getElementById('edit_MaintenanceIntervalDays').value = maintenanceInterval;
            document.getElementById('edit_Notes').value = notes;
            document.getElementById('edit_Status').value = status;

            var img = document.getElementById('edit_CurrentImage');
            if (imagePath && imagePath !== 'null' && imagePath !== '') {
                img.src = imagePath;
                img.style.display = 'block';
            } else {
                img.style.display = 'none';
            }

            document.getElementById('editModal').style.display = 'flex';
        }
        function closeEditModal() { document.getElementById('editModal').style.display = 'none'; }

        function confirmDelete(id, name) {
            document.getElementById('delete_EquipmentId').value = id;
            document.getElementById('deleteEquipmentName').textContent = name;
            document.getElementById('deleteModal').style.display = 'flex';
        }
        function closeDeleteModal() { document.getElementById('deleteModal').style.display = 'none'; }

        // repairId / excludedTechId / excludedTechName are only passed for
        // post-repair "Verify Repair" rows — routine "Inspect" rows pass
        // null/null/'' and the dropdown behaves exactly as before.
        function openInspectModal(id, name, code, repairId, excludedTechId, excludedTechName, assignedTechId, assignedTechName) {
            document.getElementById('inspect_EquipmentId').value = id;
            document.getElementById('inspectEquipmentName').textContent = name;
            document.getElementById('inspectEquipmentCode').textContent = code;
            document.getElementById('inspect_RepairId').value = repairId || '';

            var noteBox = document.getElementById('inspectPostRepairNote');
            var noteText = document.getElementById('inspectPostRepairNoteText');
            var techSelect = document.getElementById('inspect_TechnicianId');
            var assignedBox = document.getElementById('inspectAssignedNote');

            // Reset every option to visible/enabled before applying any exclusion
            Array.from(techSelect.options).forEach(function (opt) {
                opt.disabled = false;
                opt.hidden = false;
            });
            techSelect.value = '';

            if (repairId && excludedTechId) {
                var optToHide = techSelect.querySelector('option[value="' + excludedTechId + '"]');
                if (optToHide) {
                    optToHide.disabled = true;
                    optToHide.hidden = true;
                }
                noteText.textContent = (excludedTechName || 'This technician') + ' performed this repair and cannot verify it — please select a different technician.';
                noteBox.style.display = 'block';
            } else {
                noteBox.style.display = 'none';
            }

            // Pre-fill (still editable) with whoever was assigned via the
            // separate Assign step — this is the split the admin asked for:
            // assignment happens first with no result fields, performing
            // happens later with the technician already selected.
            if (assignedTechId) {
                techSelect.value = assignedTechId;
                assignedBox.textContent = 'Assigned to: ' + (assignedTechName || 'technician') + ' — change the technician below if someone else is actually performing this.';
                assignedBox.style.display = 'block';
            } else {
                assignedBox.style.display = 'none';
            }

            document.getElementById('inspectModal').style.display = 'flex';
        }
        function closeInspectModal() { document.getElementById('inspectModal').style.display = 'none'; }

        function openAssignInspectionModal(equipmentId, equipName) {
            document.getElementById('assignInspection_EquipmentId').value = equipmentId;
            document.getElementById('assignInspectionEquipmentName').textContent = equipName;
            document.getElementById('assignInspectionModal').style.display = 'flex';
        }
        function closeAssignInspectionModal() { document.getElementById('assignInspectionModal').style.display = 'none'; }

        function openAssignVerificationModal(repairId, equipName, excludedTechId, excludedTechName) {
            document.getElementById('assignVerification_RepairId').value = repairId;
            document.getElementById('assignVerificationEquipmentName').textContent = equipName;

            var noteBox = document.getElementById('assignVerificationNote');
            var noteText = document.getElementById('assignVerificationNoteText');
            var techSelect = document.getElementById('assignVerification_TechnicianId');

            Array.from(techSelect.options).forEach(function (opt) {
                opt.disabled = false;
                opt.hidden = false;
            });
            techSelect.value = '';

            if (excludedTechId) {
                var optToHide = techSelect.querySelector('option[value="' + excludedTechId + '"]');
                if (optToHide) {
                    optToHide.disabled = true;
                    optToHide.hidden = true;
                }
                noteText.textContent = (excludedTechName || 'This technician') + ' performed this repair and cannot be assigned to verify it.';
                noteBox.style.display = 'block';
            } else {
                noteBox.style.display = 'none';
            }

            document.getElementById('assignVerificationModal').style.display = 'flex';
        }
        function closeAssignVerificationModal() { document.getElementById('assignVerificationModal').style.display = 'none'; }

        function openApproveModal(repairId, equipName) {
            document.getElementById('approve_RepairId').value = repairId;
            document.getElementById('approveEquipmentName').textContent = equipName;
            document.getElementById('approveModal').style.display = 'flex';
        }
        function closeApproveModal() { document.getElementById('approveModal').style.display = 'none'; }

        function openRejectModal(repairId, equipName) {
            document.getElementById('reject_RepairId').value = repairId;
            document.getElementById('rejectEquipmentName').textContent = equipName;
            document.getElementById('rejectModal').style.display = 'flex';
        }
        function closeRejectModal() { document.getElementById('rejectModal').style.display = 'none'; }

        function openMarkCompleteModal(repairId, equipName) {
            document.getElementById('markComplete_RepairId').value = repairId;
            document.getElementById('markCompleteEquipmentName').textContent = equipName;
            document.getElementById('markCompleteModal').style.display = 'flex';
        }
        function closeMarkCompleteModal() { document.getElementById('markCompleteModal').style.display = 'none'; }

        function openMarkUnrepairableModal(repairId, equipName) {
            document.getElementById('markUnrepairable_RepairId').value = repairId;
            document.getElementById('markUnrepairableEquipmentName').textContent = equipName;
            document.getElementById('markUnrepairableModal').style.display = 'flex';
        }
        function closeMarkUnrepairableModal() { document.getElementById('markUnrepairableModal').style.display = 'none'; }

        function openAssignModal(repairId, equipName, recommendedId, recommendedName) {
            document.getElementById('assign_RepairId').value = repairId;
            document.getElementById('assignEquipmentName').textContent = equipName;

            var recBox = document.getElementById('assignRecommendation');
            if (recommendedId) {
                document.getElementById('assignRecommendedName').textContent = recommendedName;
                document.getElementById('assign_TechnicianId').value = recommendedId;
                recBox.style.display = 'block';
            } else {
                recBox.style.display = 'none';
                document.getElementById('assign_TechnicianId').value = '';
            }

            document.getElementById('assignModal').style.display = 'flex';
        }
        function closeAssignModal() { document.getElementById('assignModal').style.display = 'none'; }

        function openReassignModal(repairId, equipName) {
            document.getElementById('reassign_RepairId').value = repairId;
            document.getElementById('reassignEquipmentName').textContent = equipName;
            document.getElementById('reassignModal').style.display = 'flex';
        }
        function closeReassignModal() { document.getElementById('reassignModal').style.display = 'none'; }

        function openReassignMaintenanceModal(equipmentId, equipName, currentTechId) {
            document.getElementById('reassignMaintenance_EquipmentId').value = equipmentId;
            document.getElementById('reassignMaintenanceEquipmentName').textContent = equipName;
            document.getElementById('reassignMaintenance_TechnicianId').value = currentTechId || '';
            document.getElementById('reassignMaintenanceModal').style.display = 'flex';
        }
        function closeReassignMaintenanceModal() { document.getElementById('reassignMaintenanceModal').style.display = 'none'; }

        function openVendorModal(repairId, equipName) {
            document.getElementById('vendor_RepairId').value = repairId;
            document.getElementById('vendorEquipmentName').textContent = equipName;
            document.getElementById('vendorModal').style.display = 'flex';
        }
        function closeVendorModal() { document.getElementById('vendorModal').style.display = 'none'; }

        function switchTab(tab) {
            document.querySelectorAll('.tab-panel').forEach(p => p.style.display = 'none');
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + tab).style.display = 'block';
            document.querySelector('.tab-btn[data-tab="' + tab + '"]').classList.add('active');
        }

        document.querySelectorAll('.modal-overlay').forEach(function (overlay) {
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) {
                    overlay.style.display = 'none';
                }
            });
        });
    </script>
}
